<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_list" model="ir.ui.view">
        <field name="name">saas.reseller.commission.list</field>
        <field name="model">saas.reseller.commission</field>
        <field name="arch" type="xml">
            <list string="Commissions" create="0">
                <field name="create_date"/>
                <field name="reseller_id"/>
                <field name="tenant_id"/>
                <field name="payment_amount"/>
                <field name="commission_rate"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">saas.reseller.commission</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_payout_list" model="ir.ui.view">
        <field name="name">saas.reseller.payout.list</field>
        <field name="model">saas.reseller.payout</field>
        <field name="arch" type="xml">
            <list string="Payouts" decoration-success="state == 'paid'">
                <field name="number"/>
                <field name="reseller_id"/>
                <field name="amount"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="state" widget="badge"/>
                <field name="paid_date"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                    invisible="state != 'draft'"/>
                <button name="action_mark_paid" type="object" string="Mark Paid" icon="fa-money"
                    invisible="state != 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_payout_form" model="ir.ui.view">
        <field name="name">saas.reseller.payout.form</field>
        <field name="model">saas.reseller.payout</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-success"
                        invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="number"/></h1></div>
                    <group>
                        <group>
                            <field name="reseller_id"/>
                            <field name="amount"/>
                            <field name="currency"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="paid_date"/>
                            <field name="payment_reference"/>
                        </group>
                    </group>
                    <field name="commission_ids" readonly="1">
                        <list>
                            <field name="tenant_id"/>
                            <field name="payment_amount"/>
                            <field name="amount"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payout" model="ir.actions.act_window">
        <field name="name">Payouts</field>
        <field name="res_model">saas.reseller.payout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
