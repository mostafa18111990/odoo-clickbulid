<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reseller_dashboard" name="Reseller Dashboard">
        <t t-call="portal.portal_layout">
            <h2 class="mb-4">Reseller Dashboard — <t t-out="reseller.name"/></h2>
            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body">
                    <h6 class="text-muted">Customers</h6><h3 t-out="reseller.customer_count"/>
                </div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body">
                    <h6 class="text-muted">Active</h6><h3 t-out="reseller.active_customer_count"/>
                </div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body">
                    <h6 class="text-muted">Total Earned</h6>
                    <h3><t t-out="'%.0f' % reseller.total_earned"/> <small t-out="reseller.currency"/></h3>
                </div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body">
                    <h6 class="text-muted">Balance Due</h6>
                    <h3 class="text-success"><t t-out="'%.0f' % reseller.balance_due"/></h3>
                </div></div></div>
            </div>
            <div class="d-flex gap-2">
                <a href="/reseller/customers" class="btn btn-outline-primary">Customers</a>
                <a href="/reseller/commissions" class="btn btn-outline-primary">Commissions</a>
                <a href="/reseller/payouts" class="btn btn-outline-primary">Payouts</a>
            </div>
        </t>
    </template>

    <template id="reseller_customers" name="Reseller Customers">
        <t t-call="portal.portal_layout">
            <h3 class="mb-4">My Customers</h3>
            <table class="table">
                <thead><tr><th>Name</th><th>Subdomain</th><th>Plan</th><th>Status</th></tr></thead>
                <tbody><t t-foreach="customers" t-as="c"><tr>
                    <td t-out="c.name"/>
                    <td t-out="c.subdomain"/>
                    <td t-out="c.plan_id.name"/>
                    <td><span class="badge bg-info" t-out="c.state"/></td>
                </tr></t></tbody>
            </table>
        </t>
    </template>

    <template id="reseller_commissions" name="Reseller Commissions">
        <t t-call="portal.portal_layout">
            <h3 class="mb-4">Commissions</h3>
            <table class="table">
                <thead><tr><th>Date</th><th>Customer</th><th>Payment</th><th>Commission</th><th>Status</th></tr></thead>
                <tbody><t t-foreach="commissions" t-as="c"><tr>
                    <td t-out="c.create_date"/>
                    <td t-out="c.tenant_id.name"/>
                    <td><t t-out="'%.2f' % c.payment_amount"/></td>
                    <td><t t-out="'%.2f' % c.amount"/> <t t-out="c.currency"/></td>
                    <td><span class="badge bg-secondary" t-out="c.state"/></td>
                </tr></t></tbody>
            </table>
        </t>
    </template>

    <template id="reseller_payouts" name="Reseller Payouts">
        <t t-call="portal.portal_layout">
            <h3 class="mb-4">Payouts</h3>
            <table class="table">
                <thead><tr><th>Number</th><th>Amount</th><th>Period</th><th>Status</th><th>Paid</th></tr></thead>
                <tbody><t t-foreach="payouts" t-as="p"><tr>
                    <td t-out="p.number"/>
                    <td><t t-out="'%.2f' % p.amount"/> <t t-out="p.currency"/></td>
                    <td><t t-out="p.period_start"/> - <t t-out="p.period_end"/></td>
                    <td><span class="badge bg-secondary" t-out="p.state"/></td>
                    <td t-out="p.paid_date"/>
                </tr></t></tbody>
            </table>
        </t>
    </template>
</odoo>
