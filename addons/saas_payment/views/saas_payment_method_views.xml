<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_pm_list" model="ir.ui.view">
        <field name="name">saas.payment.method.list</field>
        <field name="model">saas.payment.method</field>
        <field name="arch" type="xml">
            <list string="Payment Methods" create="0">
                <field name="tenant_id"/>
                <field name="display_name"/>
                <field name="method_type"/>
                <field name="card_expiry"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="verified"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_saas_payment_method" model="ir.actions.act_window">
        <field name="name">Saved Payment Methods</field>
        <field name="res_model">saas.payment.method</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
