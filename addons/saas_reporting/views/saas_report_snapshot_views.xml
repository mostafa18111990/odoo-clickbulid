<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_snapshot_list" model="ir.ui.view">
        <field name="name">saas.report.snapshot.list</field>
        <field name="model">saas.report.snapshot</field>
        <field name="arch" type="xml">
            <list string="Daily Snapshots">
                <field name="snapshot_date"/>
                <field name="mrr"/>
                <field name="arr"/>
                <field name="active_subscriptions"/>
                <field name="paying_customers"/>
                <field name="churn_rate"/>
                <field name="arpu"/>
                <field name="ltv"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_snapshot_form" model="ir.ui.view">
        <field name="name">saas.report.snapshot.form</field>
        <field name="model">saas.report.snapshot</field>
        <field name="arch" type="xml">
            <form string="Snapshot">
                <sheet>
                    <group>
                        <group>
                            <field name="snapshot_date"/>
                            <field name="mrr"/>
                            <field name="arr"/>
                            <field name="net_mrr_movement"/>
                            <field name="new_mrr"/>
                            <field name="expansion_mrr"/>
                            <field name="contraction_mrr"/>
                            <field name="churned_mrr"/>
                        </group>
                        <group>
                            <field name="active_subscriptions"/>
                            <field name="trial_subscriptions"/>
                            <field name="paying_customers"/>
                            <field name="new_signups"/>
                            <field name="churned_customers"/>
                            <field name="arpu"/>
                            <field name="ltv"/>
                            <field name="churn_rate"/>
                            <field name="gross_revenue"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_snapshot_graph" model="ir.ui.view">
        <field name="name">saas.report.snapshot.graph</field>
        <field name="model">saas.report.snapshot</field>
        <field name="arch" type="xml">
            <graph string="MRR Trend" type="line">
                <field name="snapshot_date"/>
                <field name="mrr" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_saas_snapshot" model="ir.actions.act_window">
        <field name="name">Daily Metrics</field>
        <field name="res_model">saas.report.snapshot</field>
        <field name="view_mode">list,graph,form</field>
    </record>
</odoo>
