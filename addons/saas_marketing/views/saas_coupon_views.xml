<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_coupon_list" model="ir.ui.view">
        <field name="name">saas.coupon.list</field>
        <field name="model">saas.coupon</field>
        <field name="arch" type="xml">
            <list string="Coupons" decoration-success="state == 'active'" decoration-muted="state in ('expired','paused')">
                <field name="code"/>
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="redemption_count"/>
                <field name="max_redemptions"/>
                <field name="valid_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_saas_coupon_form" model="ir.ui.view">
        <field name="name">saas.coupon.form</field>
        <field name="model">saas.coupon</field>
        <field name="arch" type="xml">
            <form string="Coupon">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="currency_id"/>
                            <field name="minimum_amount"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="max_redemptions"/>
                            <field name="max_per_user"/>
                            <field name="redemption_count" readonly="1"/>
                            <field name="first_time_only"/>
                            <field name="reseller_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eligible Plans">
                            <field name="plan_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Redemptions">
                            <field name="redemption_ids">
                                <list>
                                    <field name="redeemed_at"/>
                                    <field name="tenant_id"/>
                                    <field name="subscription_id"/>
                                    <field name="amount_discounted"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_saas_coupon" model="ir.actions.act_window">
        <field name="name">Coupons</field>
        <field name="res_model">saas.coupon</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
