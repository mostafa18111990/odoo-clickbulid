<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pwd_policy_form" model="ir.ui.view">
        <field name="name">saas.password.policy.form</field>
        <field name="model">saas.password.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="min_length"/>
                            <field name="require_uppercase"/>
                            <field name="require_lowercase"/>
                            <field name="require_digit"/>
                            <field name="require_special"/>
                        </group>
                        <group>
                            <field name="history_count"/>
                            <field name="rotation_days"/>
                            <field name="max_failed_attempts"/>
                            <field name="lockout_minutes"/>
                            <field name="breach_check_enabled"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pwd_policy_list" model="ir.ui.view">
        <field name="name">saas.password.policy.list</field>
        <field name="model">saas.password.policy</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="min_length"/><field name="rotation_days"/><field name="active"/></list>
        </field>
    </record>
    <record id="action_pwd_policy" model="ir.actions.act_window">
        <field name="name">Password Policies</field>
        <field name="res_model">saas.password.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
