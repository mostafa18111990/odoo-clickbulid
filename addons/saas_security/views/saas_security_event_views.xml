<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_event_list" model="ir.ui.view">
        <field name="name">saas.security.event.list</field>
        <field name="model">saas.security.event</field>
        <field name="arch" type="xml">
            <list string="Security Events" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-muted="resolved">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="description"/>
                <field name="resolved"/>
            </list>
        </field>
    </record>
    <record id="view_security_event_form" model="ir.ui.view">
        <field name="name">saas.security.event.form</field>
        <field name="model">saas.security.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" type="object" string="Mark Resolved"
                            class="btn-primary" invisible="resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="severity"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                        </group>
                        <group>
                            <field name="resolved"/>
                            <field name="resolved_at"/>
                            <field name="resolved_by"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="details"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_security_event" model="ir.actions.act_window">
        <field name="name">Security Events</field>
        <field name="res_model">saas.security.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
