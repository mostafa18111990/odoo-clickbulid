<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_2fa_list" model="ir.ui.view">
        <field name="name">saas.user.2fa.list</field>
        <field name="model">saas.user.2fa</field>
        <field name="arch" type="xml">
            <list decoration-success="enabled">
                <field name="user_id"/>
                <field name="method"/>
                <field name="enabled"/>
                <field name="enabled_at"/>
                <field name="last_verified_at"/>
            </list>
        </field>
    </record>
    <record id="view_user_2fa_form" model="ir.ui.view">
        <field name="name">saas.user.2fa.form</field>
        <field name="model">saas.user.2fa</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enable" type="object" string="Enable"
                            class="btn-primary" invisible="enabled"/>
                    <button name="action_disable" type="object" string="Disable"
                            invisible="not enabled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="method"/>
                            <field name="phone_number" invisible="method != 'sms'"/>
                            <field name="enabled" readonly="1"/>
                        </group>
                        <group>
                            <field name="enabled_at" readonly="1"/>
                            <field name="last_verified_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="backup_codes" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_user_2fa" model="ir.actions.act_window">
        <field name="name">User 2FA</field>
        <field name="res_model">saas.user.2fa</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
