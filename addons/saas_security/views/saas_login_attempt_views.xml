<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_login_attempt_list" model="ir.ui.view">
        <field name="name">saas.login.attempt.list</field>
        <field name="model">saas.login.attempt</field>
        <field name="arch" type="xml">
            <list string="Login Attempts" decoration-danger="not success">
                <field name="create_date"/>
                <field name="email"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="success"/>
                <field name="failure_reason"/>
                <field name="country"/>
            </list>
        </field>
    </record>
    <record id="action_login_attempt" model="ir.actions.act_window">
        <field name="name">Login Attempts</field>
        <field name="res_model">saas.login.attempt</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
