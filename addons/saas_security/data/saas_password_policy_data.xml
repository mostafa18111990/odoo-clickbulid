<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="password_policy_default" model="saas.password.policy">
            <field name="name">Default Password Policy</field>
            <field name="min_length">10</field>
            <field name="require_uppercase" eval="True"/>
            <field name="require_lowercase" eval="True"/>
            <field name="require_digit" eval="True"/>
            <field name="require_special" eval="True"/>
            <field name="history_count">5</field>
            <field name="rotation_days">180</field>
            <field name="max_failed_attempts">5</field>
            <field name="lockout_minutes">30</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
