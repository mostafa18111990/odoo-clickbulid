<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_detect_brute_force" model="ir.cron">
            <field name="name">SaaS Security: Detect Brute Force</field>
            <field name="model_id" ref="model_saas_login_attempt"/>
            <field name="state">code</field>
            <field name="code">model.cron_detect_brute_force()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_cleanup_old_attempts" model="ir.cron">
            <field name="name">SaaS Security: Cleanup Old Login Attempts</field>
            <field name="model_id" ref="model_saas_login_attempt"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_old()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
