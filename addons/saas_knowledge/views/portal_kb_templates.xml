<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_help_index" name="Help Center">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Help Center</h2>
                <form method="get" action="/my/saas/help" class="mb-3">
                    <input type="text" name="search" t-att-value="search" class="form-control" placeholder="Search articles..."/>
                </form>
                <div class="row">
                    <div t-foreach="categories" t-as="c" class="col-md-4 mb-3">
                        <a t-attf-href="/my/saas/help/category/#{c.slug}" class="card text-decoration-none">
                            <div class="card-body">
                                <h5><i t-attf-class="fa #{c.icon}"/> <t t-out="c.name"/></h5>
                                <small><t t-out="c.article_count"/> articles</small>
                            </div>
                        </a>
                    </div>
                </div>
                <h3 t-if="featured">Featured Articles</h3>
                <ul>
                    <li t-foreach="featured" t-as="a">
                        <a t-attf-href="/my/saas/help/article/#{a.slug}"><t t-out="a.name"/></a>
                    </li>
                </ul>
                <h3 t-if="search">Results</h3>
                <ul t-if="search">
                    <li t-foreach="articles" t-as="a">
                        <a t-attf-href="/my/saas/help/article/#{a.slug}"><t t-out="a.name"/></a>
                    </li>
                </ul>
            </div>
        </t>
    </template>

    <template id="portal_help_category" name="Help Category">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2><t t-out="category.name"/></h2>
                <p><t t-out="category.description"/></p>
                <ul>
                    <li t-foreach="articles" t-as="a">
                        <a t-attf-href="/my/saas/help/article/#{a.slug}"><t t-out="a.name"/></a>
                        <small class="text-muted"> — <t t-out="a.summary"/></small>
                    </li>
                </ul>
            </div>
        </t>
    </template>

    <template id="portal_help_article" name="Help Article">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <nav><a href="/my/saas/help">← Help Center</a></nav>
                <h1><t t-out="article.name"/></h1>
                <p class="text-muted"><small><t t-out="article.category_id.name"/> · <t t-out="article.view_count"/> views</small></p>
                <div t-field="article.body"/>
                <hr/>
                <h5>Was this helpful?</h5>
                <form t-attf-action="/my/saas/help/article/#{article.id}/feedback" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="helpful" value="1"/>
                    <button type="submit" class="btn btn-success btn-sm">Yes (<t t-out="article.helpful_count"/>)</button>
                </form>
                <form t-attf-action="/my/saas/help/article/#{article.id}/feedback" method="post" class="d-inline ms-2">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="helpful" value="0"/>
                    <button type="submit" class="btn btn-outline-danger btn-sm">No (<t t-out="article.not_helpful_count"/>)</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
