<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_kb_article_list" model="ir.ui.view">
        <field name="name">saas.kb.article.list</field>
        <field name="model">saas.kb.article</field>
        <field name="arch" type="xml">
            <list string="KB Articles" decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="visibility"/>
                <field name="state"/>
                <field name="is_featured"/>
                <field name="view_count"/>
                <field name="helpful_count"/>
                <field name="not_helpful_count"/>
            </list>
        </field>
    </record>
    <record id="view_saas_kb_article_form" model="ir.ui.view">
        <field name="name">saas.kb.article.form</field>
        <field name="model">saas.kb.article</field>
        <field name="arch" type="xml">
            <form string="KB Article">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            invisible="state != 'published'"/>
                    <button name="action_archive_article" type="object" string="Archive"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug"/>
                            <field name="category_id"/>
                            <field name="visibility"/>
                            <field name="tags"/>
                        </group>
                        <group>
                            <field name="author_id"/>
                            <field name="is_featured"/>
                            <field name="sequence"/>
                            <field name="view_count" readonly="1"/>
                            <field name="helpful_count" readonly="1"/>
                            <field name="not_helpful_count" readonly="1"/>
                            <field name="published_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary">
                            <field name="summary"/>
                        </page>
                        <page string="Body">
                            <field name="body"/>
                        </page>
                        <page string="Feedback">
                            <field name="feedback_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="is_helpful"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_saas_kb_article_search" model="ir.ui.view">
        <field name="name">saas.kb.article.search</field>
        <field name="model">saas.kb.article</field>
        <field name="arch" type="xml">
            <search string="Articles">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tags"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="featured" string="Featured" domain="[('is_featured','=',True)]"/>
                <filter name="public" string="Public" domain="[('visibility','=','public')]"/>
                <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                <filter name="group_state" string="State" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
    <record id="action_saas_kb_article" model="ir.actions.act_window">
        <field name="name">KB Articles</field>
        <field name="res_model">saas.kb.article</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_saas_kb_article_search"/>
    </record>
</odoo>
