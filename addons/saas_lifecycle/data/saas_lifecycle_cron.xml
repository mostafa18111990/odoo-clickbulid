<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_dunning_cycle" model="ir.cron">
            <field name="name">SaaS Lifecycle: Dunning Cycle</field>
            <field name="model_id" ref="model_saas_dunning_attempt"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_dunning()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_lifecycle_engine" model="ir.cron">
            <field name="name">SaaS Lifecycle: Automation Engine</field>
            <field name="model_id" ref="model_saas_lifecycle_rule"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_lifecycle()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
