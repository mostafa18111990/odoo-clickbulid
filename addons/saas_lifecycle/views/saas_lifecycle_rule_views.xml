<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_lifecycle_rule_list" model="ir.ui.view">
        <field name="name">saas.lifecycle.rule.list</field>
        <field name="model">saas.lifecycle.rule</field>
        <field name="arch" type="xml">
            <list string="Lifecycle Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="from_state" widget="badge"/>
                <field name="delay_hours" string="After (h)"/>
                <field name="delay_type"/>
                <field name="action" widget="badge"/>
                <field name="to_state"/>
                <field name="last_run" optional="show"/>
                <field name="execution_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_saas_lifecycle_rule_form" model="ir.ui.view">
        <field name="name">saas.lifecycle.rule.form</field>
        <field name="model">saas.lifecycle.rule</field>
        <field name="arch" type="xml">
            <form string="Lifecycle Rule">
                <sheet>
                    <div class="float-end"><field name="active" widget="boolean_toggle"/></div>
                    <div class="oe_title"><h1><field name="name"/></h1><field name="description"/></div>
                    <group>
                        <group string="Trigger">
                            <field name="from_state"/>
                            <field name="delay_hours"/>
                            <field name="delay_type"/>
                        </group>
                        <group string="Condition (Optional)">
                            <field name="condition_field"/>
                            <field name="condition_value" invisible="not condition_field"/>
                        </group>
                    </group>
                    <group>
                        <group string="Action">
                            <field name="action"/>
                            <field name="to_state" invisible="action != 'transition'"/>
                            <field name="event_to_publish" invisible="action != 'publish_event'"/>
                        </group>
                        <group string="Notification">
                            <field name="send_email"/>
                            <field name="email_template_id" invisible="not send_email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_saas_lifecycle_rule" model="ir.actions.act_window">
        <field name="name">Lifecycle Rules</field>
        <field name="res_model">saas.lifecycle.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
