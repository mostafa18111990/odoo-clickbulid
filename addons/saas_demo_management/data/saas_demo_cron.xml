<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_demo_health" model="ir.cron">
        <field name="name">Enterprise Demos: Readiness Checks</field>
        <field name="model_id" ref="model_saas_demo_request"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_demo_health()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_expire_demos" model="ir.cron">
        <field name="name">Enterprise Demos: Expire and Suspend</field>
        <field name="model_id" ref="model_saas_demo_request"/>
        <field name="state">code</field>
        <field name="code">model.cron_expire_demos()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
