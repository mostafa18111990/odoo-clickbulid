<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_demo_template_list" model="ir.ui.view">
        <field name="name">saas.demo.template.list</field><field name="model">saas.demo.template</field>
        <field name="arch" type="xml"><list string="Enterprise Demo Templates"><field name="sequence" widget="handle"/><field name="name"/><field name="sector"/><field name="edition"/><field name="default_duration_days"/><field name="default_user_count"/><field name="pool_target"/><field name="active"/></list></field>
    </record>
    <record id="view_saas_demo_template_form" model="ir.ui.view">
        <field name="name">saas.demo.template.form</field><field name="model">saas.demo.template</field>
        <field name="arch" type="xml"><form string="Enterprise Demo Template"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="active"/><field name="sector"/><field name="edition"/></group><group><field name="default_duration_days"/><field name="default_user_count"/><field name="pool_target"/></group></group><group><field name="module_codes"/><field name="sample_scenario"/></group></sheet></form></field>
    </record>
    <record id="action_saas_demo_template" model="ir.actions.act_window"><field name="name">Sector Templates</field><field name="res_model">saas.demo.template</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_saas_demo_templates" name="Sector Templates" parent="menu_saas_demo_root" action="action_saas_demo_template" sequence="20" groups="saas_tenant_manager.group_saas_admin"/>
</odoo>
