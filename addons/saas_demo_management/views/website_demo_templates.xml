<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="industry_demo_cta" name="Enterprise Demo CTA" inherit_id="saas_website.page_solution_detail">
        <xpath expr="//t[@t-call='saas_website.solution_cta']" position="before">
            <section t-if="not is_app" class="cb-demo-sector-cta py-5">
                <div class="container"><div class="cb-demo-sector-cta__inner">
                    <div>
                        <span class="cb-demo-badge"><i class="fa fa-star me-1"/> Odoo Enterprise</span>
                        <h2><t t-if="lang_is_ar">شاهد دورة عمل قطاعك داخل ديمو مخصص</t><t t-else="">See your industry workflow in a tailored demo</t></h2>
                        <p><t t-if="lang_is_ar">قاعدة Enterprise تجريبية ببيانات آمنة وتطبيقات مناسبة لنشاطك.</t><t t-else="">A secure Enterprise demo database with applications selected for your operations.</t></p>
                    </div>
                    <a class="btn btn-light btn-lg" t-att-href="'/demo/request?industry=' + item['slug']">
                        <t t-if="lang_is_ar">اطلب ديمو مخصص لقطاعك</t><t t-else="">Request your industry demo</t>
                    </a>
                </div></div>
            </section>
        </xpath>
    </template>

    <template id="page_demo_request" name="Request Enterprise Demo">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <t t-set="additional_title"><t t-if="lang_is_ar">اطلب ديمو Odoo Enterprise</t><t t-else="">Request an Odoo Enterprise Demo</t></t>
            <main class="cb-demo-page py-5" t-att-dir="'rtl' if lang_is_ar else 'ltr'">
                <div class="container"><div class="row justify-content-center"><div class="col-xl-9">
                    <header class="text-center mb-5">
                        <span class="cb-demo-badge"><i class="fa fa-star me-1"/> Odoo Enterprise</span>
                        <h1 class="display-5 fw-bold mt-3"><t t-if="lang_is_ar">اطلب ديمو مخصص لقطاعك</t><t t-else="">Request a demo tailored to your industry</t></h1>
                        <p class="lead text-muted"><t t-if="lang_is_ar">سنراجع احتياجك ونجهز بيئة Enterprise تجريبية مناسبة لطبيعة عملك.</t><t t-else="">We will review your needs and prepare a safe Enterprise environment for your workflow.</t></p>
                    </header>
                    <div t-if="form_error" class="alert alert-danger" role="alert">
                        <t t-if="form_error == 'rate'">
                            <t t-if="lang_is_ar">تم استلام عدة طلبات؛ يرجى المحاولة لاحقًا.</t>
                            <t t-else="">Several requests were received. Please try again later.</t>
                        </t>
                        <t t-elif="form_error == 'consent'">
                            <t t-if="lang_is_ar">يجب الموافقة على سياسة الخصوصية.</t>
                            <t t-else="">You must agree to the Privacy Policy.</t>
                        </t>
                        <t t-else="">
                            <t t-if="lang_is_ar">يرجى مراجعة الحقول المطلوبة وإدخال بيانات صحيحة.</t>
                            <t t-else="">Please review the required fields and enter valid information.</t>
                        </t>
                    </div>
                    <form action="/demo/request/submit" method="post" class="cb-demo-form shadow-sm">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="utm_source" t-att-value="request.params.get('utm_source', '')"/>
                        <input type="hidden" name="utm_medium" t-att-value="request.params.get('utm_medium', '')"/>
                        <input type="hidden" name="utm_campaign" t-att-value="request.params.get('utm_campaign', '')"/>
                        <input type="text" name="website_url" tabindex="-1" autocomplete="off" class="cb-demo-honeypot" aria-hidden="true"/>
                        <div class="row g-4">
                            <div class="col-md-6"><label class="form-label" for="demo_contact_name"><t t-if="lang_is_ar">الاسم الكامل</t><t t-else="">Full name</t> *</label><input class="form-control" id="demo_contact_name" name="contact_name" required="required" maxlength="120" autocomplete="name"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_company_name"><t t-if="lang_is_ar">اسم الشركة</t><t t-else="">Company name</t> *</label><input class="form-control" id="demo_company_name" name="company_name" required="required" maxlength="160" autocomplete="organization"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_email"><t t-if="lang_is_ar">البريد الإلكتروني</t><t t-else="">Email</t> *</label><input class="form-control" id="demo_email" type="email" name="email" required="required" maxlength="254" dir="ltr" autocomplete="email"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_phone"><t t-if="lang_is_ar">رقم الجوال</t><t t-else="">Mobile number</t> *</label><input class="form-control" id="demo_phone" type="tel" name="phone" required="required" maxlength="30" dir="ltr" autocomplete="tel" inputmode="tel"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_sector"><t t-if="lang_is_ar">القطاع</t><t t-else="">Industry</t> *</label><select class="form-select" id="demo_sector" name="sector" required="required"><option value=""><t t-if="lang_is_ar">اختر القطاع</t><t t-else="">Select an industry</t></option><option t-foreach="sectors" t-as="sector" t-att-value="sector[0]" t-att-selected="sector[0] == selected_sector" t-esc="sector[1]"/></select></div>
                            <div class="col-md-3"><label class="form-label" for="demo_user_count"><t t-if="lang_is_ar">عدد المستخدمين</t><t t-else="">Users</t></label><input class="form-control" id="demo_user_count" type="number" name="user_count" value="5" min="1" max="100"/></div>
                            <div class="col-md-3"><label class="form-label" for="demo_branch_count"><t t-if="lang_is_ar">عدد الفروع</t><t t-else="">Branches</t></label><input class="form-control" id="demo_branch_count" type="number" name="branch_count" value="1" min="1" max="1000"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_company_size"><t t-if="lang_is_ar">حجم المنشأة</t><t t-else="">Company size</t></label><select class="form-select" id="demo_company_size" name="company_size"><option value="micro">1-10</option><option value="small">11-50</option><option value="medium">51-250</option><option value="large">251+</option></select></div>
                            <div class="col-md-6"><label class="form-label" for="demo_city"><t t-if="lang_is_ar">المدينة</t><t t-else="">City</t></label><input class="form-control" id="demo_city" name="city" maxlength="120" autocomplete="address-level2"/></div>
                            <div class="col-md-6"><label class="form-label" for="demo_contact_channel"><t t-if="lang_is_ar">وسيلة التواصل المفضلة</t><t t-else="">Preferred contact channel</t></label><select class="form-select" id="demo_contact_channel" name="preferred_contact_channel"><option value="phone"><t t-if="lang_is_ar">الهاتف</t><t t-else="">Phone</t></option><option value="whatsapp">WhatsApp</option><option value="email"><t t-if="lang_is_ar">البريد الإلكتروني</t><t t-else="">Email</t></option><option value="meeting"><t t-if="lang_is_ar">اجتماع عبر الإنترنت</t><t t-else="">Online meeting</t></option></select></div>
                            <div class="col-md-6"><label class="form-label" for="demo_contact_time"><t t-if="lang_is_ar">الوقت المناسب للتواصل</t><t t-else="">Preferred contact time</t></label><input class="form-control" id="demo_contact_time" name="preferred_contact_time" maxlength="240"/></div>
                            <div class="col-12"><label class="form-label" for="demo_requested_apps"><t t-if="lang_is_ar">التطبيقات المطلوبة</t><t t-else="">Requested applications</t></label><input class="form-control" id="demo_requested_apps" name="requested_apps" maxlength="2000" t-att-placeholder="'مثال: المحاسبة، المبيعات، المخزون' if lang_is_ar else 'For example: Accounting, Sales, Inventory'"/></div>
                            <div class="col-12"><label class="form-label" for="demo_notes"><t t-if="lang_is_ar">ملاحظات عن دورة العمل</t><t t-else="">Workflow notes</t></label><textarea class="form-control" id="demo_notes" name="notes" rows="4" maxlength="4000"></textarea></div>
                            <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="privacy_consent" value="1" id="demo_privacy" required="required"/><label class="form-check-label" for="demo_privacy"><t t-if="lang_is_ar">أوافق على معالجة بياناتي لغرض التواصل وتجهيز الديمو وفق</t><t t-else="">I agree to the processing of my data for contact and demo preparation under the</t> <a href="/privacy" target="_blank"><t t-if="lang_is_ar">سياسة الخصوصية</t><t t-else="">Privacy Policy</t></a>.</label></div></div>
                            <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <small class="text-muted"><i class="fa fa-lock me-1"/> <t t-if="lang_is_ar">تظهر بيانات الدخول لك في صفحة آمنة بعد اكتمال التجهيز.</t><t t-else="">Your login details appear on a secure page after preparation is complete.</t></small>
                                <button class="btn btn-primary btn-lg px-5" type="submit"><t t-if="lang_is_ar">إرسال طلب الديمو</t><t t-else="">Submit demo request</t></button>
                            </div>
                        </div>
                    </form>
                </div></div></div>
            </main>
        </t>
    </template>

    <template id="page_demo_request_success" name="Enterprise Demo Request Received">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <main class="cb-demo-page py-5" t-att-dir="'rtl' if lang_is_ar else 'ltr'">
                <div class="container">
                    <div class="cb-demo-success mx-auto text-center shadow-sm"
                         t-att-data-demo-status-endpoint="'/demo/request/status.json' if has_demo_status else None"
                         t-att-data-demo-lang="'ar' if lang_is_ar else 'en'">
                        <div class="cb-demo-success__icon" data-demo-status-icon="1">
                            <i class="fa fa-clock-o" t-if="has_demo_status"/>
                            <i class="fa fa-check" t-else=""/>
                        </div>
                        <span class="cb-demo-badge">Odoo Enterprise</span>
                        <h1 class="mt-3" data-demo-status-title="1">
                            <t t-if="lang_is_ar">تم استلام طلب الديمو</t>
                            <t t-else="">Your demo request was received</t>
                        </h1>
                        <p class="lead text-muted" data-demo-status-message="1">
                            <t t-if="has_demo_status and lang_is_ar">هذه الصفحة ستتحدث تلقائيًا. بعد موافقة الإدارة سيبدأ تجهيز بيئة Enterprise وتظهر بيانات الدخول هنا.</t>
                            <t t-elif="has_demo_status">This page updates automatically. Once approved, your Enterprise demo and login details will appear here.</t>
                            <t t-elif="lang_is_ar">تم استلام الطلب وسيقوم فريق الإدارة بمراجعته.</t>
                            <t t-else="">Your request was received and will be reviewed by the administration team.</t>
                        </p>
                        <div t-if="has_demo_status" class="cb-demo-progress-wrap my-4">
                            <div class="progress" role="progressbar" aria-label="Demo preparation progress"
                                 aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" data-demo-progress="1" style="width: 10%">10%</div>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <t t-if="lang_is_ar">يمكنك إبقاء هذه الصفحة مفتوحة أثناء التجهيز.</t>
                                <t t-else="">You may keep this page open while we prepare your demo.</t>
                            </small>
                        </div>
                        <div class="cb-demo-credentials text-start d-none" data-demo-credentials="1">
                            <h2 class="h4 mb-3">
                                <t t-if="lang_is_ar">بيانات الدخول إلى الديمو</t>
                                <t t-else="">Demo login details</t>
                            </h2>
                            <div class="cb-demo-credential-row">
                                <strong><t t-if="lang_is_ar">الرابط</t><t t-else="">URL</t></strong>
                                <a data-demo-credential="url" target="_blank" rel="noopener noreferrer"/>
                            </div>
                            <div class="cb-demo-credential-row">
                                <strong><t t-if="lang_is_ar">اسم المستخدم</t><t t-else="">Username</t></strong>
                                <code data-demo-credential="username"/>
                            </div>
                            <div class="cb-demo-credential-row">
                                <strong><t t-if="lang_is_ar">كلمة المرور</t><t t-else="">Password</t></strong>
                                <code data-demo-credential="password"/>
                            </div>
                            <div class="cb-demo-credential-row">
                                <strong><t t-if="lang_is_ar">ينتهي في</t><t t-else="">Expires</t></strong>
                                <span data-demo-credential="expires_at"/>
                            </div>
                            <a class="btn btn-primary btn-lg mt-4 w-100" data-demo-login="1"
                               target="_blank" rel="noopener noreferrer">
                                <t t-if="lang_is_ar">الدخول إلى منصة أعمالك</t>
                                <t t-else="">Open your business platform</t>
                            </a>
                        </div>
                        <a href="/industries" class="btn btn-outline-primary">
                            <t t-if="lang_is_ar">العودة إلى القطاعات</t>
                            <t t-else="">Back to industries</t>
                        </a>
                    </div>
                </div>
            </main>
        </t>
    </template>
</odoo>
