<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_retry_failed_notifications" model="ir.cron">
            <field name="name">SaaS Notifications: Retry Failed</field>
            <field name="model_id" ref="model_saas_notification"/>
            <field name="state">code</field>
            <field name="code">model.search([('status','=','failed'),('retry_count','&lt;',3),('channel','in',['email','sms'])]).write({'status':'queued'})</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
