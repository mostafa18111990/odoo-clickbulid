<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_home" name="Homepage">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <t t-set="additional_title" t-value="'تنفيذ Odoo للشركات في السعودية' if lang_is_ar else 'Odoo Implementation for Saudi Businesses'"/>
            <t t-set="meta_description" t-value="'تساعد شركة كليك بيلد لتقنية المعلومات الشركات على تحليل وتهيئة وتخصيص Odoo لربط المحاسبة والمبيعات والمخزون والمشاريع ضمن منصة متكاملة.' if lang_is_ar else 'Click Build Information Technology Company helps businesses analyze, configure, and extend Odoo across finance, sales, inventory, and projects.'"/>

            <main class="cb-home-v2" t-att-dir="'rtl' if lang_is_ar else 'ltr'">

                <!-- ════ HERO SLIDER ════ -->
                <t t-set="banners" t-value="request.env['saas.website.banner'].get_published_banners()"/>
                <section class="cb-slider-shell">
                    <div id="cbMarketingCarousel" class="carousel slide cb-marketing-carousel"
                         data-bs-ride="carousel" data-bs-interval="6500"
                         data-bs-pause="hover" data-bs-touch="true">
                        <div class="carousel-indicators">
                            <button t-foreach="banners" t-as="indicator" type="button"
                                    data-bs-target="#cbMarketingCarousel"
                                    t-att-data-bs-slide-to="'%s' % indicator_index"
                                    t-att-class="'active' if indicator_first else ''"
                                    t-att-aria-current="'true' if indicator_first else None"
                                    t-att-aria-label="'Slide %s' % (indicator_index + 1)"/>
                        </div>
                        <div class="carousel-inner">
                            <article t-foreach="banners" t-as="banner"
                                     t-attf-class="carousel-item #{'active' if banner_first else ''}">
                                <div class="cb-slide" t-att-data-visual="banner.visual_style">
                                    <div class="container cb-slide-grid">
                                        <div class="cb-slide-copy">
                                            <span class="cb-slide-brand"><t t-if="lang_is_ar">شركة كليك بيلد لتقنية المعلومات</t><t t-else="">Click Build Information Technology Company</t></span>
                                            <span class="cb-slide-eyebrow">
                                                <t t-esc="banner.eyebrow_ar if lang_is_ar else banner.eyebrow"/>
                                            </span>
                                            <h1 t-if="banner_first">
                                                <t t-esc="banner.title_ar if lang_is_ar else banner.title"/>
                                            </h1>
                                            <h2 t-else="">
                                                <t t-esc="banner.title_ar if lang_is_ar else banner.title"/>
                                            </h2>
                                            <p><t t-esc="banner.subtitle_ar if lang_is_ar else banner.subtitle"/></p>
                                            <div class="cb-v2-actions">
                                                <a t-att-href="banner.cta_url" class="btn btn-primary btn-lg">
                                                    <t t-esc="banner.cta_label_ar if lang_is_ar else banner.cta_label"/>
                                                    <i t-attf-class="fa #{'fa-arrow-left' if lang_is_ar else 'fa-arrow-right'}"/>
                                                </a>
                                                <a t-if="banner.secondary_url" t-att-href="banner.secondary_url"
                                                   class="btn btn-outline-light btn-lg">
                                                    <t t-esc="banner.secondary_label_ar if lang_is_ar else banner.secondary_label"/>
                                                </a>
                                                <a t-if="not banner.secondary_url" href="/contact"
                                                   class="btn btn-outline-light btn-lg">
                                                    <i class="fa fa-tag"/>
                                                    <t t-if="lang_is_ar">احصل على عرض سعر</t>
                                                    <t t-else="">Get a Quote</t>
                                                </a>
                                            </div>
                                            <div class="cb-v2-proof-line">
                                                <span><i class="fa fa-check-circle"/>
                                                    <t t-if="lang_is_ar">تجربة 14 يوماً مجاناً</t>
                                                    <t t-else="">14-day free trial</t>
                                                </span>
                                                <span><i class="fa fa-check-circle"/>
                                                    <t t-if="lang_is_ar">بدون بطاقة ائتمان</t>
                                                    <t t-else="">No credit card</t>
                                                </span>
                                                <span><i class="fa fa-check-circle"/>
                                                    <t t-if="lang_is_ar">دعم باللغة العربية</t>
                                                    <t t-else="">Arabic-language support</t>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="cb-product-visual" aria-hidden="true">
                                            <img t-if="banner.image_desktop or banner.image_path"
                                                 class="cb-slide-image"
                                                 t-att-src="'/web/image/saas.website.banner/%s/image_desktop' % banner.id if banner.image_desktop else banner.image_path"
                                                 t-att-alt="banner.name"/>
                                            <div t-else="" class="cb-odoo-window">
                                                <div class="cb-window-bar">
                                                    <span/><span/><span/>
                                                    <b><t t-if="lang_is_ar">شركة كليك بيلد لتقنية المعلومات</t><t t-else="">Click Build Information Technology Company</t> ERP</b>
                                                </div>
                                                <div class="cb-window-body">
                                                    <aside>
                                                        <i class="fa fa-th-large"/>
                                                        <i class="fa fa-line-chart"/>
                                                        <i class="fa fa-file-text"/>
                                                        <i class="fa fa-users"/>
                                                        <i class="fa fa-cubes"/>
                                                    </aside>
                                                    <div class="cb-ui-content">
                                                        <div class="cb-ui-heading">
                                                            <div>
                                                                <small>Business Platform</small>
                                                                <strong t-if="banner.visual_style == 'enterprise'">Enterprise</strong>
                                                                <strong t-elif="banner.visual_style == 'industries'">Industry Apps</strong>
                                                                <strong t-else="">Business Overview</strong>
                                                            </div>
                                                            <button><i class="fa fa-plus"/></button>
                                                        </div>
                                                        <div t-if="banner.visual_style == 'industries'" class="cb-ui-apps">
                                                            <span><i class="fa fa-shopping-cart"/>Retail</span>
                                                            <span><i class="fa fa-cutlery"/>Restaurants</span>
                                                            <span><i class="fa fa-building"/>Projects</span>
                                                            <span><i class="fa fa-industry"/>Manufacturing</span>
                                                            <span><i class="fa fa-truck"/>Logistics</span>
                                                            <span><i class="fa fa-briefcase"/>Services</span>
                                                        </div>
                                                        <div t-else="" class="cb-ui-metrics">
                                                            <span><small>Revenue</small><b>428,600</b></span>
                                                            <span><small>Invoices</small><b>184</b></span>
                                                            <span><small>Orders</small><b>96</b></span>
                                                        </div>
                                                        <div t-if="banner.visual_style != 'industries'" class="cb-ui-chart">
                                                            <i/><i/><i/><i/><i/><i/><i/><i/>
                                                        </div>
                                                        <div t-if="banner.visual_style == 'enterprise'" class="cb-ui-table">
                                                            <span>Sales workflow <b>Active</b></span>
                                                            <span>Approvals <b>12</b></span>
                                                            <span>Helpdesk <b>Ready</b></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div>
                        <button class="carousel-control-prev" type="button"
                                data-bs-target="#cbMarketingCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"/>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button"
                                data-bs-target="#cbMarketingCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"/>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </section>

                <!-- ════ APPS / MODULES ════ -->
                <section class="cb-v2-section cb-v2-apps">
                    <div class="container">
                        <div class="cb-v2-section-head" data-cb-reveal="1">
                            <span><t t-if="lang_is_ar">المنصة</t><t t-else="">The Platform</t></span>
                            <h2><t t-if="lang_is_ar">كل عملياتك تعمل معاً في مكان واحد</t><t t-else="">Every operation, working together</t></h2>
                            <p>
                                <t t-if="lang_is_ar">توقف عن التنقل بين أنظمة منفصلة. اجمع فريقك وبياناتك وقراراتك في منصة أعمال متكاملة.</t>
                                <t t-else="">Stop switching between disconnected tools. Keep your team, data and decisions in one connected business platform.</t>
                            </p>
                        </div>
                        <div class="cb-v2-app-grid">
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-calculator"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">المحاسبة والفوترة</t><t t-else="">Accounting &amp; Invoicing</t></h3>
                                    <p><t t-if="lang_is_ar">قيود وتقارير وفواتير إلكترونية في دورة مالية مترابطة، مع تهيئة المتطلبات السعودية عند توفر التكاملات اللازمة.</t><t t-else="">Journal entries, reports, and e-invoicing in one connected flow, configured for applicable Saudi requirements when required integrations are available.</t></p>
                                </div>
                            </article>
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-line-chart"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">المبيعات وCRM</t><t t-else="">Sales &amp; CRM</t></h3>
                                    <p><t t-if="lang_is_ar">من الفرصة وعرض السعر إلى الطلب والتحصيل بدون انقطاع.</t><t t-else="">From lead to quotation to order and collection — without gaps.</t></p>
                                </div>
                            </article>
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-cubes"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">المخزون والمشتريات</t><t t-else="">Inventory &amp; Purchasing</t></h3>
                                    <p><t t-if="lang_is_ar">رؤية لحظية للمخزون والموردين وحركة الأصناف في كل الفروع.</t><t t-else="">Real-time visibility into stock, suppliers and item movement across branches.</t></p>
                                </div>
                            </article>
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-users"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">الموارد البشرية</t><t t-else="">Human Resources</t></h3>
                                    <p><t t-if="lang_is_ar">ملفات الموظفين والإجازات والحضور والرواتب في مكان منظم واحد.</t><t t-else="">Employee records, leave, attendance and payroll in one organized place.</t></p>
                                </div>
                            </article>
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-shopping-bag"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">نقاط البيع</t><t t-else="">Point of Sale</t></h3>
                                    <p><t t-if="lang_is_ar">بيع أسرع وربط مباشر مع المخزون والمحاسبة في الوقت الحقيقي.</t><t t-else="">Faster selling with direct real-time link to inventory and accounting.</t></p>
                                </div>
                            </article>
                            <article class="cb-v2-app" data-cb-reveal="1">
                                <i class="fa fa-industry"/>
                                <div>
                                    <h3><t t-if="lang_is_ar">التصنيع والتشغيل</t><t t-else="">Manufacturing &amp; Operations</t></h3>
                                    <p><t t-if="lang_is_ar">خطط الإنتاج والمواد ومراقبة الجودة ضمن تدفق واضح ومرتب.</t><t t-else="">Production plans, materials and quality control in a clear workflow.</t></p>
                                </div>
                            </article>
                        </div>
                        <div class="text-center mt-5">
                            <a href="/features" class="btn btn-outline-primary btn-lg">
                                <t t-if="lang_is_ar">عرض جميع المميزات</t><t t-else="">View All Features</t>
                                <i t-attf-class="fa #{'fa-arrow-left' if lang_is_ar else 'fa-arrow-right'}"/>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ════ HOW IT WORKS ════ -->
                <section class="cb-v2-section cb-v2-process">
                    <div class="container">
                        <div class="cb-v2-process-layout">
                            <div class="cb-v2-process-copy" data-cb-reveal="1">
                                <span class="cb-v2-kicker">
                                    <t t-if="lang_is_ar">كيف تبدأ</t><t t-else="">How It Works</t>
                                </span>
                                <h2>
                                    <t t-if="lang_is_ar">من التسجيل إلى أول عملية في خطوات بسيطة</t>
                                    <t t-else="">From signup to your first transaction in 3 simple steps</t>
                                </h2>
                                <p>
                                    <t t-if="lang_is_ar">اختر باقتك وقطاعك، أنشئ منصة الأعمال، ثم ابدأ ببياناتك الحالية أو بإعداد جديد كلياً.</t>
                                    <t t-else="">Choose your plan and industry, create your business platform, then start with existing data or a fresh setup.</t>
                                </p>
                                <div class="d-flex flex-wrap gap-3 mt-4">
                                    <a href="/get-started" class="btn btn-primary btn-lg">
                                        <i class="fa fa-rocket"/>
                                        <t t-if="lang_is_ar">ابدأ تجربتك المجانية</t><t t-else="">Start Free Trial</t>
                                    </a>
                                    <a href="/contact" class="btn btn-outline-dark btn-lg">
                                        <i class="fa fa-phone"/>
                                        <t t-if="lang_is_ar">تواصل معنا</t><t t-else="">Contact Us</t>
                                    </a>
                                </div>
                            </div>
                            <ol class="cb-v2-steps" data-cb-reveal="1">
                                <li>
                                    <b>01</b>
                                    <div>
                                        <strong><t t-if="lang_is_ar">اختر الباقة</t><t t-else="">Choose a Plan</t></strong>
                                        <span><t t-if="lang_is_ar">الباقة والقطاع المناسبان لنشاطك</t><t t-else="">Pick the plan and industry that fit your business</t></span>
                                    </div>
                                </li>
                                <li>
                                    <b>02</b>
                                    <div>
                                        <strong><t t-if="lang_is_ar">جهّز منصة أعمالك</t><t t-else="">Set Up Your Business Platform</t></strong>
                                        <span><t t-if="lang_is_ar">الشركة والمستخدمين والبيانات الأولية</t><t t-else="">Your company, users and initial data</t></span>
                                    </div>
                                </li>
                                <li>
                                    <b>03</b>
                                    <div>
                                        <strong><t t-if="lang_is_ar">انطلق فوراً</t><t t-else="">Launch Instantly</t></strong>
                                        <span><t t-if="lang_is_ar">وشغّل جميع العمليات من مكان واحد</t><t t-else="">Run all your operations from a single place</t></span>
                                    </div>
                                </li>
                            </ol>
                        </div>
                    </div>
                </section>

                <!-- ════ INDUSTRIES ════ -->
                <section id="industries" class="cb-v2-section cb-v2-industries">
                    <div class="container">
                        <div class="cb-v2-section-head" data-cb-reveal="1">
                            <span><t t-if="lang_is_ar">حلول حسب القطاع</t><t t-else="">Industry Solutions</t></span>
                            <h2><t t-if="lang_is_ar">منصة أعمال مُصمَّمة لطبيعة نشاطك</t><t t-else="">A business platform shaped around your operations</t></h2>
                        </div>
                        <div class="cb-v2-industry-grid" data-cb-reveal="1">
                            <a href="/industries/retail">
                                <i class="fa fa-shopping-cart"/>
                                <span><t t-if="lang_is_ar">التجزئة</t><t t-else="">Retail</t></span>
                            </a>
                            <a href="/industries/restaurants-cafes">
                                <i class="fa fa-cutlery"/>
                                <span><t t-if="lang_is_ar">المطاعم</t><t t-else="">Restaurants</t></span>
                            </a>
                            <a href="/industries/ecommerce">
                                <i class="fa fa-shopping-basket"/>
                                <span><t t-if="lang_is_ar">التجارة الإلكترونية</t><t t-else="">E-commerce</t></span>
                            </a>
                            <a href="/industries/construction">
                                <i class="fa fa-building"/>
                                <span><t t-if="lang_is_ar">المقاولات</t><t t-else="">Construction</t></span>
                            </a>
                            <a href="/industries/manufacturing">
                                <i class="fa fa-industry"/>
                                <span><t t-if="lang_is_ar">التصنيع</t><t t-else="">Manufacturing</t></span>
                            </a>
                            <a href="/industries/professional-services">
                                <i class="fa fa-briefcase"/>
                                <span><t t-if="lang_is_ar">الخدمات المهنية</t><t t-else="">Services</t></span>
                            </a>
                            <a href="/industries">
                                <i class="fa fa-heartbeat"/>
                                <span><t t-if="lang_is_ar">الرعاية الصحية</t><t t-else="">Healthcare</t></span>
                            </a>
                            <a href="/industries/trading-distribution">
                                <i class="fa fa-truck"/>
                                <span><t t-if="lang_is_ar">اللوجستيات</t><t t-else="">Logistics</t></span>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ════ PRICING ════ -->
                <section class="cb-v2-section cb-v2-pricing">
                    <div class="container">
                        <div class="cb-v2-section-head" data-cb-reveal="1">
                            <span><t t-if="lang_is_ar">أسعار شفافة</t><t t-else="">Transparent Pricing</t></span>
                            <h2><t t-if="lang_is_ar">ابدأ بما تحتاجه اليوم</t><t t-else="">Start with what you need today</t></h2>
                            <p>
                                <t t-if="lang_is_ar">ثلاث باقات Community مع خيارات Enterprise للفرق التي تحتاج قدرات أوسع وأدوات متقدمة.</t>
                                <t t-else="">Three Community plans, with Enterprise options for teams that need advanced capabilities.</t>
                            </p>
                        </div>
                        <div class="row g-4 justify-content-center">
                            <t t-foreach="plans" t-as="plan">
                                <div t-if="plan.edition == 'community'" class="col-lg-4 col-md-6" data-cb-reveal="1">
                                    <article t-attf-class="cb-v2-plan #{'is-featured' if plan.is_recommended else ''}">
                                        <t t-if="plan.is_recommended">
                                            <div class="cb-v2-plan-label">
                                                <t t-if="lang_is_ar">الأكثر اختياراً</t><t t-else="">Most Popular</t>
                                            </div>
                                        </t>
                                        <h3 t-esc="plan.name"/>
                                        <t t-set="home_per_user" t-value="plan.pricing_mode == 'per_user' and plan.price_per_user > 0"/>
                                        <div class="cb-v2-plan-price">
                                            <strong t-esc="'%.0f' % (plan.price_per_user if home_per_user else plan.monthly_price)"/>
                                            <span>
                                                <t t-if="home_per_user">
                                                    <t t-if="lang_is_ar">ريال / مستخدم / شهرياً</t><t t-else="">SAR / user / month</t>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="lang_is_ar">ريال / شهر</t><t t-else="">SAR / month</t>
                                                </t>
                                            </span>
                                        </div>
                                        <ul>
                                            <li>
                                                <i class="fa fa-check"/>
                                                <t t-if="plan.max_users >= 9999">
                                                    <t t-if="lang_is_ar">مستخدمون غير محدودين</t><t t-else="">Unlimited users</t>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="lang_is_ar">حتى <t t-esc="plan.max_users"/> مستخدمين</t>
                                                    <t t-else="">Up to <t t-esc="plan.max_users"/> users</t>
                                                </t>
                                            </li>
                                            <li>
                                                <i class="fa fa-check"/>
                                                <t t-esc="round(plan.max_storage_mb/1024, 1)"/> GB
                                                <t t-if="lang_is_ar"> تخزين</t><t t-else=""> Storage</t>
                                            </li>
                                            <li>
                                                <i class="fa fa-check"/>
                                                <t t-if="lang_is_ar">دعم عربي وإنجليزي</t><t t-else="">Arabic &amp; English support</t>
                                            </li>
                                            <li>
                                                <i class="fa fa-check"/>
                                                <t t-if="lang_is_ar">نسخ احتياطي يومي</t><t t-else="">Daily automated backup</t>
                                            </li>
                                        </ul>
                                        <a t-attf-href="/get-started/#{plan.code}"
                                           t-attf-class="btn #{'btn-primary' if plan.is_recommended else 'btn-outline-primary'} w-100">
                                            <t t-if="lang_is_ar">ابدأ التجربة المجانية</t><t t-else="">Start Free Trial</t>
                                        </a>
                                    </article>
                                </div>
                            </t>
                        </div>
                        <div class="cb-v2-pricing-links" data-cb-reveal="1">
                            <a href="/pricing">
                                <i class="fa fa-list"/>
                                <t t-if="lang_is_ar">قارن جميع الباقات</t><t t-else="">Compare All Plans</t>
                            </a>
                            <a href="/pricing#enterprise">
                                <i class="fa fa-star"/>
                                <t t-if="lang_is_ar">استكشف Enterprise</t><t t-else="">Explore Enterprise</t>
                            </a>
                            <a href="/contact">
                                <i class="fa fa-tag"/>
                                <t t-if="lang_is_ar">احصل على عرض سعر</t><t t-else="">Get a Custom Quote</t>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ════ ENTERPRISE BANNER ════ -->
                <section class="cb-v2-enterprise">
                    <div class="container">
                        <div class="cb-v2-enterprise-inner" data-cb-reveal="1">
                            <div>
                                <span><t t-if="lang_is_ar">شركة كليك بيلد لتقنية المعلومات</t><t t-else="">Click Build Information Technology Company</t> Enterprise</span>
                                <h2>
                                    <t t-if="lang_is_ar">قدرات أوسع للفرق والعمليات الأكثر تعقيداً</t>
                                    <t t-else="">Advanced capabilities for larger teams and complex operations</t>
                                </h2>
                            </div>
                            <div class="d-flex flex-wrap gap-3" style="flex:0 0 auto;">
