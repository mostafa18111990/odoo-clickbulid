<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="page_error" name="Error Page">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8 text-center">
                            <div class="alert alert-danger" role="alert">
                                <h1 class="display-4">عذرًا، حدث خطأ</h1>
                                <p class="lead mt-3" t-esc="error_message"/>
                                <hr/>
                                <p class="text-muted">
                                    رمز الخطأ: <code t-esc="error_code"/>
                                </p>
                                <div class="mt-4">
                                    <a href="/" class="btn btn-primary btn-lg">
                                        <i class="fa fa-home"/> العودة إلى الصفحة الرئيسية
                                    </a>
                                    <a href="/contact" class="btn btn-secondary btn-lg ms-2">
                                        <i class="fa fa-envelope"/> تواصل معنا
                                    </a>
                                </div>
                            </div>
                            <div class="mt-5 p-4 bg-light rounded">
                                <h4>ماذا حدث؟</h4>
                                <p class="text-muted">
                                    تعذر إكمال طلبك في الوقت الحالي. يمكنك المحاولة مرة أخرى أو التواصل مع فريق الدعم.
                                </p>
                                <small class="text-muted d-block mt-3">
                                    إذا استمرت المشكلة، يرجى التواصل مع شركة كليك بيلد لتقنية المعلومات.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
