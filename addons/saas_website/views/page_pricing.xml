<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_pricing_v3" name="Pricing Calculator">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <t t-set="additional_title" t-value="'باقات Odoo وخياراتها | الأسعار' if lang_is_ar else 'Odoo Packages and Options | Pricing'"/>
            <t t-set="meta_description" t-value="'قارن باقات شركة كليك بيلد لتقنية المعلومات وافهم رسوم الاستضافة والتنفيذ والدعم، مع توضيح أن تراخيص Odoo تخضع للشروط الرسمية السارية.' if lang_is_ar else 'Compare Click Build Information Technology Company packages and understand hosting, implementation, and support fees alongside applicable Odoo licensing terms.'"/>

            <!-- ===== HEADER ===== -->
            <section class="cb-hero py-5" style="background:var(--cb-grad-hero); position:relative; overflow:hidden;">
                <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(123,63,200,0.2) 0%,transparent 70%);pointer-events:none;"/>
                <div class="container text-center py-5" data-cb-reveal="1" style="position:relative;z-index:1;">
                    <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.35rem 1rem;border-radius:100px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.9);font-size:0.8rem;font-weight:700;margin-bottom:1.4rem;">
                        <i class="fa fa-tag" style="color:var(--cb-gold);"/>
                        <t t-if="lang_is_ar">أسعار شفافة وواضحة</t><t t-else="">Transparent pricing</t>
                    </span>
                    <h1 style="color:#fff;font-size:3.2rem;font-weight:900;line-height:1.2;margin-bottom:1.1rem;">
                        <t t-if="lang_is_ar">أسعار بسيطة وعادلة</t>
                        <t t-else="">Simple, fair pricing</t>
                    </h1>
                    <p style="color:rgba(255,255,255,0.78);font-size:1.08rem;max-width:640px;margin:0 auto 2rem;">
                        <t t-if="lang_is_ar">قارن رسوم باقات شركة كليك بيلد لتقنية المعلومات وما تشمله من تشغيل ودعم. أي تراخيص خارجية تُوضح في عرض السعر قبل التعاقد.</t>
                        <t t-else="">Compare Click Build Information Technology Company package fees and included services. Any external licensing is identified in the quotation before contracting.</t>
                    </p>
                    <div class="d-flex justify-content-center mb-4">
                        <span style="background:rgba(255,255,255,0.12);color:#fff;border-radius:100px;padding:0.45rem 1.4rem;font-size:0.92rem;font-weight:600;">
                            <t t-if="lang_is_ar">الأسعار شهرية — تُفوتر سنوياً في فاتورة واحدة</t>
                            <t t-else="">Prices are per month — billed annually in one invoice</t>
                        </span>
                    </div>
                    <div style="display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;color:rgba(255,255,255,0.55);font-size:0.82rem;">
                        <span><i class="fa fa-check-circle" style="color:var(--cb-teal);margin-inline-end:0.4rem;"/><t t-if="lang_is_ar">بدون بطاقة ائتمان</t><t t-else="">No credit card</t></span>
                        <span><i class="fa fa-check-circle" style="color:var(--cb-teal);margin-inline-end:0.4rem;"/><t t-if="lang_is_ar">شروط واضحة قبل التعاقد</t><t t-else="">Clear terms before contracting</t></span>
                        <span><i class="fa fa-check-circle" style="color:var(--cb-teal);margin-inline-end:0.4rem;"/><t t-if="lang_is_ar">دعم باللغة العربية</t><t t-else="">Arabic support</t></span>
                    </div>
                </div>
            </section>

            <!-- ===== EDITION TOGGLE ===== -->
            <section class="text-center mb-4">
                <div class="container">
                    <div class="cb-edition-toggle d-inline-flex align-items-center"
                         style="background:#fff; border:1px solid #e2e8f0; border-radius:9999px; padding:4px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
                        <button type="button" data-edition="community" class="active px-4 py-2"
                                style="border:0; border-radius:9999px; font-weight:600; background:#6d28d9; color:#fff; cursor:pointer;">
                            <i class="fa fa-cube me-1"/>
                            <t t-if="lang_is_ar">Community (مفتوح المصدر)</t>
                            <t t-else="">Community (open source)</t>
                        </button>
                        <button type="button" data-edition="enterprise" class="px-4 py-2"
                                style="border:0; border-radius:9999px; font-weight:600; background:transparent; color:#6d28d9; cursor:pointer;">
                            <i class="fa fa-rocket me-1"/>
                            <t t-if="lang_is_ar">Enterprise (مع Studio &amp; Helpdesk)</t>
                            <t t-else="">Enterprise (with Studio &amp; Helpdesk)</t>
                        </button>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        <t t-if="lang_is_ar">هذه أسعار خدمات شركة كليك بيلد لتقنية المعلومات المعروضة في المنصة. تخضع رسوم تراخيص Odoo Enterprise، إن انطبقت، للأسعار والشروط الرسمية السارية وقت التعاقد. يوضح عرض السعر نطاق التنفيذ والتخصيص والتدريب والدعم والضريبة.</t>
                        <t t-else="">These are Click Build Information Technology Company service prices shown on the platform. Applicable Odoo Enterprise licensing follows Odoo's official terms and prices at contract time. The quotation defines implementation, customization, training, support, and tax treatment.</t>
                    </p>
                </div>
            </section>

            <!-- ===== PRICING CARDS ===== -->
            <section class="cb-tier-pricing py-5" id="pricing-calculator">
                <div class="container"><div class="cb-tier-card mx-auto" data-tier-calculator="1">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold"><t t-if="lang_is_ar">احسب اشتراك منصة أعمالك</t><t t-else="">Calculate your business platform subscription</t></h2>
                        <p class="text-muted mb-0"><t t-if="lang_is_ar">اختر إصدار Odoo وعدد المستخدمين، وسيتحدث السعر فورًا. الفوترة سنوية.</t><t t-else="">Choose the Odoo edition and user count for an instant quote. Billing is annual.</t></p>
                    </div>
                    <div class="cb-tier-controls">
                        <div class="cb-tier-choice" role="group" aria-label="Odoo edition">
                            <button type="button" class="active" data-tier-edition="community">Odoo Community</button>
                            <button type="button" data-tier-edition="enterprise">Odoo Enterprise</button>
                        </div>
                        <div class="cb-tier-users">
                            <label for="pricingUserCount"><t t-if="lang_is_ar">عدد المستخدمين</t><t t-else="">Number of users</t></label>
                            <div class="input-group">
                                <button type="button" class="btn btn-outline-secondary" data-tier-minus="1">−</button>
                                <input id="pricingUserCount" type="number" class="form-control text-center" min="1" max="500" value="1"/>
                                <button type="button" class="btn btn-outline-secondary" data-tier-plus="1">+</button>
                            </div>
                        </div>
                    </div>
                    <div class="cb-tier-summary mt-4">
                        <div><span><t t-if="lang_is_ar">سعر المستخدم</t><t t-else="">Price per user</t></span><strong><b data-tier-unit="1">299</b> <t t-if="lang_is_ar">ريال/شهر</t><t t-else="">SAR/month</t></strong></div>
                        <div><span><t t-if="lang_is_ar">الإجمالي الشهري</t><t t-else="">Monthly total</t></span><strong><b data-tier-monthly="1">299</b> <t t-if="lang_is_ar">ريال/شهر</t><t t-else="">SAR/month</t></strong></div>
                        <div class="cb-tier-total"><span><t t-if="lang_is_ar">تُفوتر سنوياً (12 شهراً)</t><t t-else="">Billed annually (12 months)</t></span><strong><b data-tier-total="1">3588</b> <t t-if="lang_is_ar">ريال/سنة</t><t t-else="">SAR/year</t></strong></div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100 mt-3" data-tier-cta="1" href="/get-started?edition=community&amp;users=1&amp;billing=yearly"><t t-if="lang_is_ar">طلب الاشتراك</t><t t-else="">Request subscription</t></a>
                    <div class="cb-tier-legal mt-4">
                        <p><t t-if="lang_is_ar">السعر المعروض هو سعر المستخدم الواحد ضمن شريحة الباقة المختارة. قد ينخفض سعر المستخدم في الشرائح الأكبر، بينما يُحسب إجمالي السنة تلقائيًا وفق عدد المستخدمين × سعر المستخدم الشهري × 12.</t><t t-else="">The displayed rate is per user within the selected tier. Larger tiers may have a lower per-user rate, while the annual total is calculated as users × monthly per-user rate × 12.</t></p>
                        <p><t t-if="lang_is_ar">Odoo Community بلا رسوم ترخيص من Odoo؛ قيمة الاشتراك مقابل الاستضافة والإدارة الفنية والنسخ الاحتياطي والدعم المشمول.</t><t t-else="">Odoo Community has no Odoo license fee; the subscription covers included hosting, technical management, backups, and support.</t></p>
                        <p><t t-if="lang_is_ar">تتضمن أسعار Enterprise إتاحة Odoo Enterprise عبر اشتراك الشريك، ولا تضاف رسوم ترخيص منفصلة إلا إذا نص عرض السعر على خلاف ذلك.</t><t t-else="">Enterprise prices include access through the partner subscription; no separate license fee is added unless the quotation states otherwise.</t></p>
                        <p><t t-if="lang_is_ar">الأسعار لا تشمل ضريبة القيمة المضافة. رسوم الإعداد والتهيئة والتنفيذ تُحدد بصورة منفصلة وفقًا لمتطلبات المشروع.</t><t t-else="">Prices exclude VAT. Setup, configuration, and implementation are quoted separately according to project requirements.</t></p>
                    </div>
                </div></div>
            </section>
            <section class="py-5" style="display:none; margin-top:-1rem;"><div class="container">
                <div class="row g-4 justify-content-center align-items-stretch">
                    <t t-foreach="plans" t-as="plan">
                        <t t-set="is_per_user" t-value="plan.pricing_mode == 'per_user' and plan.price_per_user > 0"/>
                        <t t-set="monthly_price" t-value="'%.0f' % (plan.price_per_user if is_per_user else plan.monthly_price)"/>
                        <t t-set="yearly_per_month" t-value="'%.2f' % (plan.price_per_user if is_per_user else (plan.get_effective_yearly_price() / 12))"/>
                        <t t-set="yearly_total" t-value="'%.2f' % ((plan.price_per_user * 12) if is_per_user else plan.get_effective_yearly_price())"/>
                        <!-- The toggle above hides cards whose edition doesn't match. -->
                        <div t-attf-class="col-lg-4 col-md-6 cb-pricing-col"
                             t-att-data-edition="plan.edition or 'community'"
                             data-cb-reveal="1">
                            <div t-attf-class="cb-pricing-card #{'featured' if plan.is_recommended else ''}">
                                <!-- Edition badge on the card -->
                                <div t-if="plan.edition == 'enterprise'" class="edition-badge"
                                     style="position:absolute; top:14px; left:14px; background:#6d28d9; color:#fff;
                                            font-size:0.7rem; font-weight:700; padding:4px 10px; border-radius:9999px;">
                                    <i class="fa fa-rocket me-1"/>Enterprise
                                </div>
                                <div t-if="plan.edition == 'community'" class="edition-badge"
                                     style="position:absolute; top:14px; left:14px; background:#e2e8f0; color:#475569;
                                            font-size:0.7rem; font-weight:700; padding:4px 10px; border-radius:9999px;">
                                    <i class="fa fa-cube me-1"/>Community
                                </div>
                                <t t-if="plan.is_recommended">
                                    <div class="featured-ribbon">
                                        <t t-if="lang_is_ar">⭐ الأكثر شيوعاً</t>
                                        <t t-else="">⭐ Most popular</t></div>
                                </t>
                                <h4 class="fw-bold text-center mb-2" t-esc="plan.name"/>
                                <p class="text-center text-muted small mb-4" t-esc="plan.description or ''"/>

                                <div class="text-center mb-3">
                                    <span class="price js-price"
                                          t-att-data-monthly="monthly_price"
                                          t-att-data-yearly="yearly_per_month"
                                          t-esc="monthly_price"/>
                                    <t t-if="is_per_user">
                                        <t t-set="suffix_text" t-value="'ريال / مستخدم / شهرياً' if lang_is_ar else 'SAR / user / month'"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="suffix_text" t-value="'ريال / شهر' if lang_is_ar else 'SAR / month'"/>
                                    </t>
                                    <span class="price-suffix js-price-suffix"
                                          t-att-data-monthly-text="suffix_text"
                                          t-att-data-yearly-text="suffix_text"
                                          t-esc="suffix_text"/>
                                </div>
                                <div t-if="is_per_user" class="text-center small text-muted mb-2">
                                    <t t-if="lang_is_ar">اختر عدد المستخدمين عند التسجيل — تدفع فقط مقابل ما تحتاجه</t>
                                    <t t-else="">Pick your user count at signup — pay only for what you need</t>
                                </div>
                                <div class="js-yearly-note text-center small text-muted mb-3">
                                    <t t-if="lang_is_ar">تُفوتر سنوياً: <strong t-esc="yearly_total"/> ريال<t t-if="is_per_user"> / مستخدم</t> (قيمة 12 شهراً)</t>
                                    <t t-else="">Billed annually: <strong t-esc="yearly_total"/> SAR<t t-if="is_per_user"> / user</t> (12 months)</t>
                                </div>

                                <ul class="list-unstyled mb-4">
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="plan.max_users >= 9999">
                                            <t t-if="lang_is_ar"><strong>مستخدمون غير محدودين</strong></t>
                                            <t t-else=""><strong>Unlimited users</strong></t>
                                        </t>
                                        <t t-else="">
                                            <t t-if="lang_is_ar">حتى <strong t-esc="plan.max_users"/> مستخدمين</t>
                                            <t t-else="">Up to <strong t-esc="plan.max_users"/> users</t>
                                        </t></li>
                                    <li><i class="fa fa-check me-2"/><strong t-esc="round(plan.max_storage_mb/1024, 1)"/>
                                        <t t-if="lang_is_ar"> جيجابايت تخزين</t><t t-else=""> GB storage</t></li>
                                    <li><i class="fa fa-check me-2"/><strong t-esc="plan.max_companies"/>
                                        <t t-if="lang_is_ar"> شركة</t><t t-else=""> companies</t></li>
                                    <li t-if="plan.extra_user_price">
                                        <i class="fa fa-plus me-2"/>
                                        <t t-if="lang_is_ar">مستخدم إضافي: <t t-esc="'%.0f' % plan.extra_user_price"/> ريال</t>
                                        <t t-else="">Extra user: <t t-esc="'%.0f' % plan.extra_user_price"/> SAR</t>
                                    </li>
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="lang_is_ar">محاسبة + ZATCA</t><t t-else="">Accounting + ZATCA</t></li>
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="lang_is_ar">مبيعات + CRM</t><t t-else="">Sales + CRM</t></li>
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="lang_is_ar">مخزون + POS</t><t t-else="">Inventory + POS</t></li>
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="lang_is_ar">دعم بالعربية</t><t t-else="">Arabic &amp; English support</t></li>
                                    <li><i class="fa fa-check me-2"/>
                                        <t t-if="lang_is_ar">نسخ احتياطي يومي</t><t t-else="">Daily backups</t></li>
                                </ul>
                                <a t-attf-href="/get-started/#{plan.code}"
                                   t-attf-class="btn #{'btn-primary' if plan.is_recommended else 'btn-outline-primary'} w-100 btn-lg">
                                    <t t-if="lang_is_ar">ابدأ التجربة المجانية</t>
                                    <t t-else="">Start free trial</t>
                                </a>
                                <p class="text-center text-muted small mt-2 mb-0">
                                    <t t-if="lang_is_ar">14 يوماً مجاناً · بدون بطاقة ائتمان</t>
                                    <t t-else="">14 days free · no credit card</t>
                                </p>
                            </div>
                        </div>
                    </t>
                </div>
            </div></section>

            <!-- ===== TRUST FEATURES ===== -->
            <section class="py-5"><div class="container">
                <div class="row text-center g-4" data-cb-reveal="1">
                    <div class="col-md-3 col-6">
                        <div class="cb-feature-icon"><i class="fa fa-shield"/></div>
                        <h6 class="fw-bold"><t t-if="lang_is_ar">بياناتك آمنة</t><t t-else="">Your data is safe</t></h6>
                        <p class="small text-muted mb-0">
                            <t t-if="lang_is_ar">تشفير TLS + عزل كامل لكل عميل</t>
                            <t t-else="">TLS encryption + full per-tenant isolation</t></p>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="cb-feature-icon"><i class="fa fa-refresh"/></div>
                        <h6 class="fw-bold"><t t-if="lang_is_ar">نسخ احتياطي</t><t t-else="">Backups</t></h6>
                        <p class="small text-muted mb-0">
                            <t t-if="lang_is_ar">نسخ احتياطية وفق سياسة الباقة واتفاقية الخدمة</t>
                            <t t-else="">Backups according to the package and service policy</t></p>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="cb-feature-icon"><i class="fa fa-headset"/></div>
                        <h6 class="fw-bold"><t t-if="lang_is_ar">دعم باللغة العربية</t><t t-else="">Arabic-language support</t></h6>
                        <p class="small text-muted mb-0">
                            <t t-if="lang_is_ar">وفق نطاق وساعات الخدمة المحددة في الباقة</t>
                            <t t-else="">According to the package's defined service scope and hours</t></p>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="cb-feature-icon"><i class="fa fa-times-circle"/></div>
                        <h6 class="fw-bold"><t t-if="lang_is_ar">إدارة التجديد</t><t t-else="">Renewal control</t></h6>
                        <p class="small text-muted mb-0">
                            <t t-if="lang_is_ar">أوقف التجديد القادم في أي وقت؛ وتستمر الخدمة حتى نهاية المدة المدفوعة</t>
                            <t t-else="">Stop the next renewal at any time; service continues through the paid term</t></p>
                    </div>
                </div>
            </div></section>

            <!-- ===== COMPARISON TABLE ===== -->
            <section class="py-5 bg-light" style="display:none;"><div class="container">
                <div class="text-center mb-5" data-cb-reveal="1">
                    <h2 class="display-5 mb-2">
                        <t t-if="lang_is_ar">مقارنة كاملة بين الخطط</t>
                        <t t-else="">Full plan comparison</t></h2>
                    <p class="text-muted">
                        <t t-if="lang_is_ar">كل المميزات في كل الخطط — الفرق فقط في الحدود</t>
                        <t t-else="">All features in every plan — only the limits change</t></p>
                </div>
                <div class="table-responsive shadow-sm rounded-3 bg-white" data-cb-reveal="1">
                    <table class="table mb-0 align-middle text-center">
                        <thead style="background:#f5f3ff;">
                            <tr>
                                <th class="text-start" style="width:35%;">
                                    <t t-if="lang_is_ar">المميزات</t><t t-else="">Features</t></th>
                                <t t-foreach="plans" t-as="p">
                                    <th t-attf-class="fw-bold #{'text-primary' if p.is_recommended else ''}">
                                        <t t-esc="p.name"/>
                                        <t t-if="p.is_recommended">
                                            <span class="d-block small text-warning">
                                                <t t-if="lang_is_ar">⭐ موصى به</t><t t-else="">⭐ Recommended</t></span>
                                        </t>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start fw-bold">
                                    <t t-if="lang_is_ar">السعر الشهري</t><t t-else="">Monthly price</t></td>
                                <t t-foreach="plans" t-as="p">
                                    <td>
                                        <t t-if="p.pricing_mode == 'per_user' and p.price_per_user > 0">
                                            <strong t-esc="'%.0f' % p.price_per_user"/>
                                            <t t-if="lang_is_ar"> ريال/مستخدم</t><t t-else=""> SAR/user</t>
                                        </t>
                                        <t t-else="">
                                            <strong t-esc="'%.0f' % p.monthly_price"/>
                                            <t t-if="lang_is_ar"> ريال</t><t t-else=""> SAR</t>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">
                                    <t t-if="lang_is_ar">عدد المستخدمين</t><t t-else="">Users</t></td>
                                <t t-foreach="plans" t-as="p">
                                    <td><strong t-esc="'∞' if p.max_users >= 9999 else p.max_users"/></td>
                                </t>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">
                                    <t t-if="lang_is_ar">مساحة التخزين</t><t t-else="">Storage</t></td>
                                <t t-foreach="plans" t-as="p"><td><strong t-esc="round(p.max_storage_mb/1024, 1)"/> GB</td></t>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">
                                    <t t-if="lang_is_ar">عدد الشركات</t><t t-else="">Companies</t></td>
                                <t t-foreach="plans" t-as="p"><td><strong t-esc="p.max_companies"/></td></t>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">
                                    <t t-if="lang_is_ar">المحاسبة + ZATCA</t><t t-else="">Accounting + ZATCA</t></td>
                                <t t-foreach="plans" t-as="p"><td><i class="fa fa-check text-success"/></td></t>
                            </tr>
