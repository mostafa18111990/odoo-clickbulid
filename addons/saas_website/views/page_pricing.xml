            <!-- Edition toggle JS — runs once on first render -->
            <script type="text/javascript">
                (function() {
                    var buttons = document.querySelectorAll('.cb-edition-toggle button[data-edition]');
                    var cols    = document.querySelectorAll('.cb-pricing-col[data-edition]');
                    if (!buttons.length || !cols.length) return;
                    function applyEdition(ed) {
                        buttons.forEach(function(b) {
                            var active = b.dataset.edition === ed;
                            b.style.background = active ? '#6d28d9' : 'transparent';
                            b.style.color      = active ? '#fff'    : '#6d28d9';
                            b.classList.toggle('active', active);
                        });
                        cols.forEach(function(c) {
                            c.style.display = (c.dataset.edition === ed) ? '' : 'none';
                        });
                    }
                    buttons.forEach(function(b) {
                        b.addEventListener('click', function() {
                            applyEdition(b.dataset.edition);
                            // Reflect the choice in the URL so the user can bookmark.
                            history.replaceState(null, '', '#' + b.dataset.edition);
                        });
                    });
                    // Honour any hash from incoming links (e.g. /pricing#enterprise).
                    var initial = (location.hash || '').replace('#', '');
                    applyEdition(initial === 'enterprise' ? 'enterprise' : 'community');
                })();
            </script>
