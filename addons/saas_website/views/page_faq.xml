<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_faq" name="FAQ">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <t t-set="additional_title" t-value="'الأسئلة الشائعة عن Odoo وخدماتنا' if lang_is_ar else 'Odoo Services Frequently Asked Questions'"/>
            <t t-set="meta_description" t-value="'إجابات واضحة عن تطبيق Odoo والباقات والتجربة والدعم والبيانات وخطوات البدء مع شركة كليك بيلد لتقنية المعلومات.' if lang_is_ar else 'Clear answers about Odoo implementation, packages, trials, support, data, and getting started with Click Build Information Technology Company.'"/>
            <section class="py-5"><div class="container py-4">
                <div class="text-center mb-5">
                    <h1 class="display-5 fw-bold">
                        <t t-if="lang_is_ar">الأسئلة الشائعة</t>
                        <t t-else="">Frequently asked questions</t></h1>
                </div>
                <div class="row justify-content-center"><div class="col-lg-8">
                    <div class="accordion" id="faqAccordion">
                        <t t-foreach="faqs" t-as="faq">
                            <div class="accordion-item border-0 shadow-sm mb-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" t-attf-data-bs-target="#faqq#{faq.id}">
                                        <t t-esc="faq.question"/></button></h2>
                                <div t-attf-id="faqq#{faq.id}" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body text-muted"><t t-esc="faq.answer"/></div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <p class="text-center text-muted mt-4 small" t-if="not faqs">
                        <t t-if="lang_is_ar">لا توجد أسئلة منشورة حالياً.</t>
                        <t t-else="">No published questions yet.</t></p>
                </div></div>
            </div></section>
        </t>
    </template>
</odoo>
