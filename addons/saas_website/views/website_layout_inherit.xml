<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branded ClickBuild footer — bilingual EN/AR. -->
    <template id="layout_footer_inherit" name="ClickBuild Footer"
              inherit_id="website.layout">
        <xpath expr="//footer" position="replace">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/><t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <footer class="cb-footer" data-cb-reveal="1">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-lg-4 col-md-12">
                            <div class="brand-logo">
                                Click<span class="accent">Build</span>
                            </div>
                            <p class="mb-3" style="opacity:0.85;">
                                <t t-if="lang_is_ar">منصة ERP سحابية متكاملة تساعد الشركات على إدارة محاسبتها،
                                مبيعاتها، مخزونها ومواردها البشرية من مكان واحد.</t>
                                <t t-else="">All-in-one cloud ERP that lets companies run accounting, sales,
                                inventory and HR from a single place.</t>
                            </p>
                            <a href="mailto:info@clickbulid.com" class="cb-footer-contact o_force_ltr">
                                <i class="fa fa-envelope"/> info@clickbulid.com
                            </a>
                            <a href="https://wa.me/966599109021" target="_blank" rel="noopener"
                               class="cb-footer-contact o_force_ltr d-block mt-2" style="color:#25D366;">
                                <i class="fa fa-whatsapp"/> +966 59 910 9021
                            </a>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <h5><t t-if="lang_is_ar">المنتج</t><t t-else="">Product</t></h5>
                            <ul>
                                <li><a href="/features"><t t-if="lang_is_ar">المميزات</t><t t-else="">Features</t></a></li>
                                <li><a href="/pricing"><t t-if="lang_is_ar">الأسعار</t><t t-else="">Pricing</t></a></li>
                                <li><a href="/get-started"><t t-if="lang_is_ar">جرّب مجاناً</t><t t-else="">Free trial</t></a></li>
                                <li><a href="/help"><t t-if="lang_is_ar">مركز المساعدة</t><t t-else="">Help center</t></a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <h5><t t-if="lang_is_ar">الشركة</t><t t-else="">Company</t></h5>
                            <ul>
                                <li><a href="/about"><t t-if="lang_is_ar">عن ClickBuild</t><t t-else="">About</t></a></li>
                                <li><a href="/contact"><t t-if="lang_is_ar">تواصل معنا</t><t t-else="">Contact</t></a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <h5><t t-if="lang_is_ar">الموارد</t><t t-else="">Resources</t></h5>
                            <ul>
                                <li><a href="/faq"><t t-if="lang_is_ar">الأسئلة الشائعة</t><t t-else="">FAQ</t></a></li>
                                <li><a href="/help"><t t-if="lang_is_ar">مركز المساعدة</t><t t-else="">Help center</t></a></li>
                                <li><a href="https://odoo.clickbulid.com/web/login"><t t-if="lang_is_ar">تسجيل الدخول</t><t t-else="">Log in</t></a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-12 col-6">
                            <h5><t t-if="lang_is_ar">قانوني</t><t t-else="">Legal</t></h5>
                            <ul>
                                <li><a href="/terms"><t t-if="lang_is_ar">الشروط</t><t t-else="">Terms</t></a></li>
                                <li><a href="/privacy"><t t-if="lang_is_ar">الخصوصية</t><t t-else="">Privacy</t></a></li>
                                <li><a href="/dpa"><t t-if="lang_is_ar">حماية البيانات</t><t t-else="">DPA</t></a></li>
                                <li><a href="/sla">SLA</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="bottom-bar d-flex flex-wrap justify-content-between align-items-center">
                        <div>© <span id="cb-year"/>
                            <script>document.getElementById('cb-year').textContent = new Date().getFullYear();</script>
                            ClickBuild.
                            <t t-if="lang_is_ar"> جميع الحقوق محفوظة.</t>
                            <t t-else=""> All rights reserved.</t>
                        </div>
                        <div class="d-flex gap-3 align-items-center small">
                            <span><i class="fa fa-shield me-1"/>
                                <t t-if="lang_is_ar">SSL مشفّر</t><t t-else="">SSL secured</t></span>
                            <span><i class="fa fa-check-circle me-1"/>
                                <t t-if="lang_is_ar">نسخ احتياطي يومي</t><t t-else="">Daily backups</t></span>
                            <span><i class="fa fa-language me-1"/>
                                <t t-if="lang_is_ar">عربي وإنجليزي</t><t t-else="">Arabic &amp; English</t></span>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

    <template id="header_contact_details_inherit" name="ClickBuild Header Contact"
              inherit_id="website.header_text_element">
        <xpath expr="(//a[starts-with(@href, 'tel:+1 555-555-5556')])[3]"
               position="replace">
            <a href="mailto:sales@clickbulid.com" class="nav-link o_nav-link_secondary p-2">
                <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                <span class="o_force_ltr"><small>sales@clickbulid.com</small></span>
            </a>
        </xpath>
        <xpath expr="(//a[starts-with(@href, 'tel:+1 555-555-5556')])[2]"
               position="replace">
            <a href="mailto:sales@clickbulid.com"
               class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                <span class="o_force_ltr"><small>sales@clickbulid.com</small></span>
            </a>
        </xpath>
        <xpath expr="(//a[starts-with(@href, 'tel:+1 555-555-5556')])[1]"
               position="replace">
            <a href="mailto:sales@clickbulid.com" class="nav-link o_nav-link_secondary">
                <small>
                    <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                    <span class="o_force_ltr">sales@clickbulid.com</span>
                </small>
            </a>
        </xpath>
    </template>

    <template id="header_cta_inherit" name="ClickBuild Header CTA"
              inherit_id="website.header_call_to_action">
        <xpath expr="//a[contains(@class, 'btn_cta')]" position="attributes">
            <attribute name="href">/contact</attribute>
        </xpath>
    </template>
</odoo>
