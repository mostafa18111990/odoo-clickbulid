<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_contact" name="Contact">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>
            <section class="py-5"><div class="container py-4">
                <div class="row justify-content-center"><div class="col-lg-6">
                    <h1 class="fw-bold mb-4 text-center">
                        <t t-if="lang_is_ar">تواصل معنا</t><t t-else="">Contact us</t></h1>
                    <t t-if="submitted">
                        <div class="alert alert-success text-center"><i class="fa fa-check-circle me-2"/>
                            <t t-if="lang_is_ar">شكراً لتواصلك! سنرد عليك قريباً.</t>
                            <t t-else="">Thanks for reaching out — we'll get back to you soon.</t></div>
                    </t>
                    <div class="card border-0 shadow-sm"><div class="card-body p-4">
                        <form method="post" action="/contact/submit">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3"><label class="form-label">
                                <t t-if="lang_is_ar">الاسم</t><t t-else="">Name</t></label>
                                <input type="text" name="name" class="form-control" required="required"/></div>
                            <div class="mb-3"><label class="form-label">
                                <t t-if="lang_is_ar">البريد الإلكتروني</t><t t-else="">Email</t></label>
                                <input type="email" name="email" class="form-control" required="required"/></div>
                            <div class="mb-3"><label class="form-label">
                                <t t-if="lang_is_ar">الجوال</t><t t-else="">Phone</t></label>
                                <input type="tel" name="phone" class="form-control"/></div>
                            <div class="mb-3"><label class="form-label">
                                <t t-if="lang_is_ar">الرسالة</t><t t-else="">Message</t></label>
                                <textarea name="message" class="form-control" rows="4" required="required"/></div>
                            <button type="submit" class="btn btn-primary w-100">
                                <t t-if="lang_is_ar">إرسال</t><t t-else="">Send</t></button>
                        </form>
                    </div></div>
                    <div class="text-center mt-4 text-muted">
                        <p><i class="fa fa-envelope me-2"/> support@clickbuild.com</p></div>
                </div></div>
            </div></section>
        </t>
    </template>
</odoo>
