<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_contact" name="Contact">
        <t t-call="website.layout">
            <t t-set="lang_code" t-value="request.env.lang or request.env.context.get('lang') or 'ar_001'"/>
            <t t-set="lang_is_ar" t-value="lang_code in ('ar_001', 'ar')"/>

            <!-- HERO -->
            <section class="cb-hero py-5" style="background:var(--cb-grad-hero);position:relative;overflow:hidden;">
                <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 20% 60%,rgba(20,184,166,0.1) 0%,transparent 60%);pointer-events:none;"/>
                <div class="container text-center py-5" style="position:relative;z-index:1;">
                    <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.35rem 1rem;border-radius:100px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.9);font-size:0.8rem;font-weight:700;margin-bottom:1.4rem;">
                        <i class="fa fa-headphones" style="color:var(--cb-teal);"/>
                        <t t-if="lang_is_ar">نحن هنا لمساعدتك</t><t t-else="">We're here to help</t>
                    </span>
                    <h1 style="color:#fff;font-size:3rem;font-weight:900;line-height:1.2;margin-bottom:0.8rem;">
                        <t t-if="lang_is_ar">تواصل مع فريق ClickBuild</t>
                        <t t-else="">Talk to the ClickBuild Team</t>
                    </h1>
                    <p style="color:rgba(255,255,255,0.75);font-size:1.05rem;max-width:580px;margin:0 auto;">
                        <t t-if="lang_is_ar">سواء كنت تريد تجربة مجانية، عرض سعر، أو مجرد استفسار — فريقنا يرد خلال ساعات.</t>
                        <t t-else="">Whether you want a free trial, a quote, or just have questions — our team responds within hours.</t>
                    </p>
                </div>
            </section>

            <!-- CONTACT SECTION -->
            <section class="py-5" style="background:var(--cb-surface);">
                <div class="container py-3">
                    <div class="row g-5 align-items-start">

                        <!-- LEFT: Contact info cards -->
                        <div class="col-lg-4" data-cb-reveal="1">
                            <h2 style="color:var(--cb-ink);font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">
                                <t t-if="lang_is_ar">معلومات التواصل</t><t t-else="">Contact Info</t>
                            </h2>

                            <!-- Email card -->
                            <div style="background:#fff;border-radius:var(--cb-radius-lg);padding:1.4rem 1.6rem;margin-bottom:1rem;box-shadow:var(--cb-shadow-card);border:1px solid var(--cb-line);display:flex;gap:1rem;align-items:flex-start;">
                                <div style="width:44px;height:44px;border-radius:10px;background:var(--cb-primary-lt);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fa fa-envelope" style="color:var(--cb-primary);font-size:1.1rem;"/>
                                </div>
                                <div>
                                    <div style="font-weight:700;color:var(--cb-ink);margin-bottom:0.25rem;">
                                        <t t-if="lang_is_ar">البريد الإلكتروني</t><t t-else="">Email</t>
                                    </div>
                                    <a href="mailto:sales@clickbulid.com" style="color:var(--cb-primary);font-size:0.92rem;">sales@clickbulid.com</a>
                                </div>
                            </div>

                            <!-- WhatsApp card -->
                            <div style="background:#fff;border-radius:var(--cb-radius-lg);padding:1.4rem 1.6rem;margin-bottom:1rem;box-shadow:var(--cb-shadow-card);border:1px solid var(--cb-line);display:flex;gap:1rem;align-items:flex-start;">
                                <div style="width:44px;height:44px;border-radius:10px;background:#DCFCE7;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fa fa-whatsapp" style="color:#16A34A;font-size:1.1rem;"/>
                                </div>
                                <div>
                                    <div style="font-weight:700;color:var(--cb-ink);margin-bottom:0.25rem;">WhatsApp</div>
                                    <a href="https://wa.me/966500000000" style="color:#16A34A;font-size:0.92rem;" target="_blank" rel="noopener">
                                        <t t-if="lang_is_ar">راسلنا على واتساب</t><t t-else="">Chat on WhatsApp</t>
                                    </a>
                                </div>
                            </div>

                            <!-- Hours card -->
                            <div style="background:#fff;border-radius:var(--cb-radius-lg);padding:1.4rem 1.6rem;margin-bottom:1rem;box-shadow:var(--cb-shadow-card);border:1px solid var(--cb-line);display:flex;gap:1rem;align-items:flex-start;">
                                <div style="width:44px;height:44px;border-radius:10px;background:var(--cb-teal-lt);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fa fa-clock-o" style="color:var(--cb-teal-dk);font-size:1.1rem;"/>
                                </div>
                                <div>
                                    <div style="font-weight:700;color:var(--cb-ink);margin-bottom:0.25rem;">
                                        <t t-if="lang_is_ar">أوقات العمل</t><t t-else="">Business Hours</t>
                                    </div>
                                    <div style="color:var(--cb-muted);font-size:0.88rem;">
                                        <t t-if="lang_is_ar">الأحد – الخميس: 9 ص – 6 م (بتوقيت الرياض)</t>
                                        <t t-else="">Sun – Thu: 9 AM – 6 PM (Riyadh time)</t>
                                    </div>
                                </div>
                            </div>

                            <!-- Response time -->
                            <div style="background:var(--cb-primary-lt);border-radius:var(--cb-radius-lg);padding:1.2rem 1.4rem;border:1px solid rgba(123,63,200,0.15);">
                                <i class="fa fa-bolt" style="color:var(--cb-primary);margin-inline-end:0.5rem;"/>
                                <strong style="color:var(--cb-primary-dk);">
                                    <t t-if="lang_is_ar">وقت الرد: أقل من ساعتين</t><t t-else="">Response time: under 2 hours</t>
                                </strong>
                                <p style="color:var(--cb-muted);font-size:0.82rem;margin-top:0.3rem;margin-bottom:0;">
                                    <t t-if="lang_is_ar">خلال ساعات العمل الرسمية</t><t t-else="">During business hours</t>
                                </p>
                            </div>
                        </div>

                        <!-- RIGHT: Contact form -->
                        <div class="col-lg-8" data-cb-reveal="1">
                            <div style="background:#fff;border-radius:var(--cb-radius-xl);padding:2.5rem;box-shadow:var(--cb-shadow-md);border:1px solid var(--cb-line);">
                                <h3 style="color:var(--cb-ink);font-weight:800;margin-bottom:0.5rem;">
                                    <t t-if="lang_is_ar">أرسل لنا رسالة</t><t t-else="">Send Us a Message</t>
                                </h3>
                                <p style="color:var(--cb-muted);font-size:0.92rem;margin-bottom:2rem;">
                                    <t t-if="lang_is_ar">سنرد عليك بأسرع وقت ممكن على البريد الإلكتروني الخاص بك.</t>
                                    <t t-else="">We'll respond as quickly as possible to the email you provide.</t>
                                </p>

                                <t t-if="submitted">
                                    <div style="background:#F0FDF4;border:1px solid #86EFAC;border-radius:var(--cb-radius-lg);padding:1.5rem;text-align:center;margin-bottom:1.5rem;">
                                        <i class="fa fa-check-circle" style="color:#16A34A;font-size:2rem;display:block;margin-bottom:0.5rem;"/>
                                        <strong style="color:#15803D;">
                                            <t t-if="lang_is_ar">شكراً لتواصلك! سنرد عليك قريباً.</t>
                                            <t t-else="">Thanks for reaching out — we'll get back to you soon.</t>
                                        </strong>
                                    </div>
                                </t>

                                <form method="post" action="/contact/submit">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <!-- Request type (hidden, set by URL param) -->
                                    <input type="hidden" name="request_type" t-att-value="request.params.get('type','general')"/>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">الاسم الكامل *</t><t t-else="">Full Name *</t>
                                            </label>
                                            <input type="text" name="name" class="form-control" required="required"
                                                   style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;"
                                                   t-att-placeholder="'محمد أحمد' if lang_is_ar else 'John Smith'"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">الشركة</t><t t-else="">Company</t>
                                            </label>
                                            <input type="text" name="company" class="form-control"
                                                   style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;"
                                                   t-att-placeholder="'شركة النجاح' if lang_is_ar else 'Acme Corp'"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">البريد الإلكتروني *</t><t t-else="">Email *</t>
                                            </label>
                                            <input type="email" name="email" class="form-control" required="required"
                                                   style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;"
                                                   t-att-placeholder="'email@company.com' if lang_is_ar else 'email@company.com'"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">رقم الجوال</t><t t-else="">Phone</t>
                                            </label>
                                            <input type="tel" name="phone" class="form-control"
                                                   style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;"
                                                   t-att-placeholder="'+966 5X XXX XXXX' if lang_is_ar else '+966 5X XXX XXXX'"/>
                                        </div>
                                        <div class="col-12">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">نوع الطلب</t><t t-else="">Request type</t>
                                            </label>
                                            <select name="inquiry_type" class="form-select"
                                                    style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;">
                                                <option value="general">
                                                    <t t-if="lang_is_ar">استفسار عام</t><t t-else="">General inquiry</t>
                                                </option>
                                                <option value="trial">
                                                    <t t-if="lang_is_ar">طلب تجربة مجانية</t><t t-else="">Request free trial</t>
                                                </option>
                                                <option value="quote">
                                                    <t t-if="lang_is_ar">طلب عرض سعر</t><t t-else="">Request a quote</t>
                                                </option>
                                                <option value="demo">
                                                    <t t-if="lang_is_ar">طلب عرض تجريبي (Demo)</t><t t-else="">Request a demo</t>
                                                </option>
                                                <option value="support">
                                                    <t t-if="lang_is_ar">دعم فني</t><t t-else="">Technical support</t>
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label style="font-weight:600;color:var(--cb-ink);font-size:0.88rem;margin-bottom:0.4rem;display:block;">
                                                <t t-if="lang_is_ar">رسالتك *</t><t t-else="">Your message *</t>
                                            </label>
                                            <textarea name="message" class="form-control" rows="4" required="required"
                                                      style="border-radius:8px;border:1.5px solid var(--cb-line);padding:0.7rem 0.9rem;resize:vertical;"
                                                      t-att-placeholder="'أخبرنا عن نشاطك التجاري وما تحتاجه...' if lang_is_ar else 'Tell us about your business and what you need...'"/>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                                <i class="fa fa-paper-plane"/>
                                                <t t-if="lang_is_ar">إرسال الرسالة</t><t t-else="">Send Message</t>
                                            </button>
                                            <p style="text-align:center;color:var(--cb-muted);font-size:0.8rem;margin-top:0.75rem;margin-bottom:0;">
                                                <i class="fa fa-lock me-1"/>
                                                <t t-if="lang_is_ar">معلوماتك محمية ولن نشاركها مع أي طرف ثالث.</t>
                                                <t t-else="">Your information is protected and will never be shared.</t>
                                            </p>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CTA BAND -->
            <section class="cb-v2-cta-band">
                <div class="container">
                    <div class="cb-v2-cta-band-inner" data-cb-reveal="1">
                        <div>
                            <h3>
                                <t t-if="lang_is_ar">مستعد للبدء؟ جرّب ClickBuild مجاناً لمدة 14 يوماً.</t>
                                <t t-else="">Ready to start? Try ClickBuild free for 14 days.</t>
                            </h3>
                        </div>
                        <div class="cb-cta-actions">
                            <a href="/get-started" class="btn btn-light btn-lg">
                                <i class="fa fa-rocket"/>
                                <t t-if="lang_is_ar">ابدأ التجربة المجانية</t><t t-else="">Start Free Trial</t>
                            </a>
                            <a href="/pricing" class="btn btn-outline-light btn-lg">
                                <i class="fa fa-tag"/>
                                <t t-if="lang_is_ar">عرض الأسعار</t><t t-else="">View Pricing</t>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
