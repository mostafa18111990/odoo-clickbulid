<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="banner_cloud_erp" model="saas.website.banner">
        <field name="name">Cloud ERP</field>
        <field name="sequence">10</field>
        <field name="eyebrow">Odoo cloud platform</field>
        <field name="eyebrow_ar">منصة Odoo السحابية</field>
        <field name="title">Your entire business. One connected platform.</field>
        <field name="title_ar">أعمالك بالكامل في منصة واحدة مترابطة</field>
        <field name="subtitle">Run accounting, sales, inventory, HR and operations with a business platform built for Saudi companies.</field>
        <field name="subtitle_ar">أدر المحاسبة والمبيعات والمخزون والموارد البشرية والعمليات ضمن منصة أعمال مصممة للشركات السعودية.</field>
        <field name="visual_style">operations</field>
        <field name="image_path">/saas_website/static/src/img/hero-executive-dashboard.png</field>
        <field name="cta_label">Request a demo</field>
        <field name="cta_label_ar">اطلب عرضاً توضيحياً</field>
        <field name="cta_url">/contact?type=demo</field>
        <field name="secondary_label">Talk to a consultant</field>
        <field name="secondary_label_ar">تحدث مع مستشار</field>
        <field name="secondary_url">/contact?type=consultation</field>
    </record>

    <record id="banner_enterprise" model="saas.website.banner">
        <field name="name">Enterprise</field>
        <field name="sequence">20</field>
        <field name="eyebrow">Click Build Information Technology Company Enterprise</field>
        <field name="eyebrow_ar">شركة كليك بيلد لتقنية المعلومات Enterprise</field>
        <field name="title">More control for growing teams.</field>
        <field name="title_ar">تحكم أكبر للفرق سريعة النمو</field>
        <field name="subtitle">Advanced apps, Studio, Helpdesk and the flexibility to shape Odoo around your operation.</field>
        <field name="subtitle_ar">تطبيقات متقدمة وStudio وHelpdesk ومرونة أكبر لتشكيل Odoo وفق عمليات شركتك.</field>
        <field name="visual_style">enterprise</field>
        <field name="cta_label">View Enterprise</field>
        <field name="cta_label_ar">عرض Enterprise</field>
        <field name="cta_url">/pricing#enterprise</field>
        <field name="secondary_label">Compare plans</field>
        <field name="secondary_label_ar">قارن الباقات</field>
        <field name="secondary_url">/pricing</field>
    </record>

    <record id="banner_industries" model="saas.website.banner">
        <field name="name">Industry Solutions</field>
        <field name="sequence">30</field>
        <field name="eyebrow">Solutions shaped for your industry</field>
        <field name="eyebrow_ar">حلول تُهيأ وفق قطاعك</field>
        <field name="title">Connect the workflows that matter to your industry.</field>
        <field name="title_ar">اربط العمليات الأهم في قطاعك</field>
        <field name="subtitle">Combine standard Odoo apps and clearly scoped customization for retail, construction, manufacturing, services, and more.</field>
        <field name="subtitle_ar">اجمع تطبيقات Odoo القياسية مع تخصيص محدد النطاق للتجزئة والمقاولات والتصنيع والخدمات وغيرها.</field>
        <field name="visual_style">industries</field>
        <field name="cta_label">Choose your industry</field>
        <field name="cta_label_ar">اختر قطاعك</field>
        <field name="cta_url">/industries</field>
        <field name="secondary_label">See solutions</field>
        <field name="secondary_label_ar">عرض الحلول</field>
        <field name="secondary_url">/services</field>
    </record>
</odoo>
