<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Welcome email sent after signup with login credentials. -->
        <record id="email_template_signup_welcome" model="mail.template">
            <field name="name">SaaS: Welcome &amp; Credentials</field>
            <field name="model_id" ref="saas_tenant_manager.model_saas_tenant"/>
            <field name="subject">مرحباً بك في ClickBuild — بيانات الدخول لمساحة عملك</field>
            <field name="email_from">${(object.env['saas.config']._get_config().from_email or 'no-reply@clickbulid.com')}</field>
            <field name="email_to">${object.customer_email}</field>
            <field name="lang">ar_001</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:20px; background:#f5f3ff; font-family:Tahoma, sans-serif; direction:rtl;" dir="rtl">
    <div style="max-width:600px; margin:0 auto; background:white; border-radius:12px; overflow:hidden;
                box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <div style="background:#5b21b6; color:white; padding:30px; text-align:center;">
            <h1 style="margin:0; font-size:28px;">🎉 مرحباً بك في ClickBuild</h1>
            <p style="margin:8px 0 0; opacity:0.9;">مساحة العمل جاهزة!</p>
        </div>

        <div style="padding:30px;">
            <p style="font-size:16px;">عزيزي <strong t-out="object.customer_name or 'العميل'"/>،</p>
            <p>تم إنشاء مساحة العمل الخاصة بـ <strong t-out="object.company_name or object.name"/>
               بنجاح. فيما يلي بيانات الدخول. <strong style="color:#dc2626;">احفظها في مكان آمن.</strong></p>

            <div style="background:#fef3c7; border:1px solid #fde68a; padding:18px;
                        border-radius:8px; margin:20px 0;">
                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td style="padding:8px; font-weight:bold; vertical-align:top; width:130px;">الرابط:</td>
                        <td style="padding:8px;">
                            <a t-attf-href="https://#{object.subdomain}.#{object.env['saas.config']._get_config().platform_domain}"
                               style="color:#5b21b6;">
                                <span t-out="object.subdomain"/>.<span t-out="object.env['saas.config']._get_config().platform_domain"/>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:8px; font-weight:bold;">البريد:</td>
                        <td style="padding:8px;"><code t-out="object.customer_email"/></td>
                    </tr>
                    <tr>
                        <td style="padding:8px; font-weight:bold;">كلمة المرور:</td>
                        <td style="padding:8px;"><code t-out="ctx.get('admin_password', '')"
                                                       style="background:#fff; padding:4px 8px; border-radius:4px;
                                                              border:1px solid #d4d4d8; font-size:14px;"/></td>
                    </tr>
                </table>
            </div>

            <div style="text-align:center; margin:30px 0;">
                <a t-attf-href="https://#{object.subdomain}.#{object.env['saas.config']._get_config().platform_domain}/web/login"
                   style="display:inline-block; background:#5b21b6; color:white; padding:14px 32px;
                          border-radius:8px; text-decoration:none; font-weight:bold; font-size:16px;">
                    🚀 تسجيل الدخول الآن
                </a>
            </div>

            <p style="color:#6b7280; font-size:14px; line-height:1.6;">
                الفترة التجريبية مدتها <strong>14 يوم</strong>، بدون بطاقة ائتمان.
                إذا كنت بحاجة لأي مساعدة، فقط رد على هذه الرسالة وفريق الدعم سيرد عليك خلال 24 ساعة.
            </p>

            <hr style="border:none; border-top:1px solid #e5e7eb; margin:30px 0;"/>
            <p style="color:#9ca3af; font-size:12px; text-align:center; margin:0;">
                ClickBuild SaaS — هذه الرسالة تلقائية، يُرجى عدم الرد عليها مباشرة.
            </p>
        </div>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
