<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_list" model="ir.ui.view">
        <field name="name">saas.ai.provider.list</field>
        <field name="model">saas.ai.provider</field>
        <field name="arch" type="xml">
            <list decoration-success="is_default">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_model"/>
                <field name="cost_per_1k_input_tokens"/>
                <field name="cost_per_1k_output_tokens"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">saas.ai.provider.form</field>
        <field name="model">saas.ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="base_url"/>
                            <field name="default_model"/>
                            <field name="max_tokens"/>
                            <field name="temperature"/>
                            <field name="timeout_seconds"/>
                            <field name="api_key_encrypted" password="True"/>
                        </group>
                        <group>
                            <field name="cost_per_1k_input_tokens"/>
                            <field name="cost_per_1k_output_tokens"/>
                            <field name="currency_id"/>
                            <field name="monthly_budget"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">saas.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
