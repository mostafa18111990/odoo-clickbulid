<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_prompt_list" model="ir.ui.view">
        <field name="name">saas.ai.prompt.template.list</field>
        <field name="model">saas.ai.prompt.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="language"/>
                <field name="request_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ai_prompt_form" model="ir.ui.view">
        <field name="name">saas.ai.prompt.template.form</field>
        <field name="model">saas.ai.prompt.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="language"/>
                            <field name="request_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Message">
                            <field name="system_message"/>
                        </page>
                        <page string="Body">
                            <field name="body"/>
                        </page>
                        <page string="Variables">
                            <field name="variables"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompt Templates</field>
        <field name="res_model">saas.ai.prompt.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
