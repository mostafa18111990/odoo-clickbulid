<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_subscription_list" model="ir.ui.view">
        <field name="name">saas.subscription.list</field>
        <field name="model">saas.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions"
                  decoration-success="status == 'active'"
                  decoration-warning="status in ('trial','past_due')"
                  decoration-danger="status in ('cancelled','expired')"
                  decoration-muted="status == 'paused'">
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <field name="billing_cycle" widget="badge"/>
                <field name="status" widget="badge"/>
                <field name="total_amount" string="Amount"/>
                <field name="currency"/>
                <field name="current_period_end" string="Period End"/>
                <field name="next_renewal_date" string="Renewal"/>
                <field name="days_to_renewal" string="Days"/>
                <field name="credit_balance"/>
                <field name="is_current" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_saas_subscription_form" model="ir.ui.view">
        <field name="name">saas.subscription.form</field>
        <field name="model">saas.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_view_history" type="object" string="View History" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="trial,active,past_due,paused,cancelled"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" invisible="not cancel_at_period_end">
                        Scheduled to cancel at period end (<field name="current_period_end" class="d-inline"/>).
                    </div>
                    <div class="oe_title"><h1><field name="display_name" readonly="1"/></h1></div>
                    <group>
                        <group string="Subscription">
                            <field name="tenant_id"/>
                            <field name="plan_id"/>
                            <field name="billing_cycle" readonly="1"/>
                            <field name="currency"/>
                            <field name="is_current"/>
                        </group>
                        <group string="Pricing">
                            <field name="base_amount"/>
                            <field name="discount_amount"/>
                            <field name="coupon_code"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="unbilled_overage" readonly="1"/>
                            <field name="credit_balance"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Period">
                            <field name="current_period_start"/>
                            <field name="current_period_end"/>
                            <field name="next_renewal_date"/>
                            <field name="days_to_renewal" readonly="1"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_gateway"/>
                            <field name="last_payment_date" readonly="1"/>
                            <field name="last_payment_amount" readonly="1"/>
                            <field name="failed_payment_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Usage Lines">
                            <field name="line_ids" mode="list">
                                <list>
                                    <field name="period_start"/>
                                    <field name="line_type" widget="badge"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount"/>
                                    <field name="billed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pending Changes">
                            <field name="pending_change_ids" mode="list">
                                <list>
                                    <field name="change_type" widget="badge"/>
                                    <field name="from_plan_id"/>
                                    <field name="to_plan_id"/>
                                    <field name="effective_date"/>
                                    <field name="proration_amount"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_saas_subscription_search" model="ir.ui.view">
        <field name="name">saas.subscription.search</field>
        <field name="model">saas.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <filter name="filter_active" string="Active" domain="[('status','=','active')]"/>
                <filter name="filter_trial" string="Trial" domain="[('status','=','trial')]"/>
                <filter name="filter_past_due" string="Past Due" domain="[('status','=','past_due')]"/>
                <filter name="filter_current" string="Current" domain="[('is_current','=',True)]"/>
                <group name="group_by">
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_cycle" string="Cycle" context="{'group_by': 'billing_cycle'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_saas_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">saas.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_saas_subscription_search"/>
        <field name="context">{'search_default_filter_current': 1}</field>
    </record>

    <!-- Keep the operational data an administrator needs on the tenant itself.
         The values already live on saas.tenant / saas.subscription; this view
         makes them visible together so a platform admin does not have to hunt
         through separate menus. -->
    <record id="view_saas_tenant_form_subscription_details" model="ir.ui.view">
        <field name="name">saas.tenant.form.subscription.details</field>
        <field name="model">saas.tenant</field>
        <field name="inherit_id" ref="saas_tenant_manager.view_saas_tenant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_subscriptions" icon="fa-refresh">
                    <field name="subscription_count" widget="statinfo" string="الاشتراكات"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='admin_password']/.." position="after">
                <group string="بيانات إدارة العميل">
                    <group string="الدخول إلى منصة العميل">
                        <field name="tenant_url" widget="url"/>
                        <field name="admin_login" string="اسم المستخدم"/>
                        <field name="admin_password" string="كلمة المرور"
                               widget="CopyClipboardChar"/>
                    </group>
                    <group string="المستخدمون والتمديد">
                        <field name="user_count" string="عدد المستخدمين المشترى"
                               help="إذا كانت القيمة صفراً يتم استخدام الحد المحدد في الباقة."/>
                        <field name="trial_ends_at" string="تاريخ انتهاء/قفل العميل"/>
                        <field name="trial_days_left" string="الأيام المتبقية" readonly="1"/>
                        <field name="sub_next_renewal" string="موعد التجديد" readonly="1"/>
                        <button name="action_extend_trial" type="object"
                                string="تمديد العميل 7 أيام"
                                class="btn btn-info"
                                groups="saas_tenant_manager.group_saas_admin"
                                invisible="state not in ('trial', 'suspended')"
                                confirm="سيتم تمديد العميل 7 أيام. متابعة؟"/>
                        <button name="action_view_subscriptions" type="object"
                                string="فتح سجل الاشتراكات"
                                class="btn btn-secondary"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook/page[1]" position="before">
                <page string="بيانات الدخول والاشتراك" name="tenant_access_subscription">
                    <group string="بيانات دخول منصة العميل">
                        <group>
                            <field name="tenant_url" widget="url"/>
                            <field name="admin_login"/>
                            <field name="admin_password" widget="CopyClipboardChar"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="phone"/>
                            <field name="company_name"/>
                        </group>
                    </group>

                    <group string="الفترة والاشتراك الحالي">
                        <group>
                            <field name="current_subscription_id"/>
                            <field name="sub_status" widget="badge" readonly="1"/>
                            <field name="plan_id"/>
                            <field name="billing_cycle" readonly="1"/>
                            <field name="sub_total_amount" readonly="1"/>
                            <field name="user_count" string="عدد المستخدمين المشترى"/>
                        </group>
                        <group>
                            <field name="trial_started_at" readonly="1"/>
                            <field name="trial_ends_at"/>
                            <field name="trial_days_left" readonly="1"/>
                            <field name="sub_next_renewal" readonly="1"/>
                            <field name="sub_days_to_renewal" readonly="1"/>
                            <field name="next_billing_date"/>
                            <field name="last_payment_date" readonly="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 mb-3">
                        <button name="action_extend_trial" type="object"
                                string="تمديد التجربة 7 أيام"
                                class="btn btn-info"
                                groups="saas_tenant_manager.group_saas_admin"
                                invisible="state not in ('trial', 'suspended')"
                                confirm="سيتم تمديد فترة التجربة 7 أيام. متابعة؟"/>
                        <button name="action_view_subscriptions" type="object"
                                string="فتح سجل الاشتراكات"
                                class="btn btn-secondary"/>
                    </div>

                    <field name="subscription_ids" readonly="1">
                        <list decoration-success="status == 'active'"
                              decoration-warning="status in ('trial', 'past_due')"
                              decoration-danger="status in ('cancelled', 'expired')">
                            <field name="plan_id"/>
                            <field name="status" widget="badge"/>
                            <field name="billing_cycle"/>
                            <field name="trial_start"/>
                            <field name="trial_end"/>
                            <field name="current_period_start"/>
                            <field name="current_period_end"/>
                            <field name="next_renewal_date"/>
                            <field name="last_payment_date"/>
                            <field name="total_amount"/>
                            <field name="currency"/>
                            <field name="is_current"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Operational columns on the tenant list: admins asked to see access
         details and seat counts without opening every tenant individually. -->
    <record id="view_saas_tenant_list_access_details" model="ir.ui.view">
        <field name="name">saas.tenant.list.access.details</field>
        <field name="model">saas.tenant</field>
        <field name="inherit_id" ref="saas_tenant_manager.view_saas_tenant_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subdomain']" position="after">
                <field name="admin_login" string="اسم المستخدم"/>
                <field name="admin_password" string="كلمة المرور"
                       widget="CopyClipboardChar"/>
                <field name="user_count" string="المقاعد المشتراة"/>
                <field name="users_count" string="المستخدمون الفعليون"/>
                <field name="trial_ends_at" string="تاريخ الانتهاء"/>
                <button name="action_extend_trial" type="object"
                        string="تمديد 7 أيام" icon="fa-clock-o"
                        groups="saas_tenant_manager.group_saas_admin"
                        invisible="state not in ('trial', 'suspended')"
                        confirm="سيتم تمديد العميل 7 أيام. متابعة؟"/>
            </xpath>
        </field>
    </record>
</odoo>
