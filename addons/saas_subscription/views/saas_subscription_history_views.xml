<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_sub_history_list" model="ir.ui.view">
        <field name="name">saas.subscription.history.list</field>
        <field name="model">saas.subscription.history</field>
        <field name="arch" type="xml">
            <list string="Subscription History" create="0" delete="0" edit="0">
                <field name="create_date" string="Time"/>
                <field name="tenant_id"/>
                <field name="event_type" widget="badge"/>
                <field name="old_plan_id" string="From"/>
                <field name="new_plan_id" string="To"/>
                <field name="amount"/>
                <field name="proration_amount" optional="show"/>
                <field name="credit_amount" optional="show"/>
                <field name="user_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_saas_sub_history" model="ir.actions.act_window">
        <field name="name">Subscription History</field>
        <field name="res_model">saas.subscription.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
