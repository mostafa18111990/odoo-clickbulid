<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="followup_contact_new" model="clickbuild.crm.followup.rule">
            <field name="name">Website inquiry follow-up</field>
            <field name="trigger">contact_new</field>
            <field name="delay_days">1</field>
            <field name="summary">Review website inquiry</field>
            <field name="note">Review the request, qualify the need, and agree the next action.</field>
        </record>
        <record id="followup_demo_requested" model="clickbuild.crm.followup.rule">
            <field name="name">Enterprise demo review</field>
            <field name="trigger">demo_requested</field>
            <field name="delay_days">0</field>
            <field name="summary">Review Enterprise demo request</field>
            <field name="note">Validate sector, applications, users, and demo readiness before approval.</field>
        </record>
        <record id="followup_demo_delivered" model="clickbuild.crm.followup.rule">
            <field name="name">Demo delivery follow-up</field>
            <field name="trigger">demo_delivered</field>
            <field name="delay_days">1</field>
            <field name="summary">Follow up after demo delivery</field>
            <field name="note">Confirm access, capture feedback, and agree the commercial next step.</field>
        </record>
    </data>
</odoo>
