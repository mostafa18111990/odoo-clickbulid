<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_clickbuild_bridge" model="ir.ui.view">
        <field name="name">crm.lead.form.clickbuild.bridge</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ClickBuild Attribution" invisible="not clickbuild_origin">
                    <group>
                        <group><field name="clickbuild_origin"/><field name="clickbuild_website_lead_id"/><field name="clickbuild_demo_request_id"/></group>
                        <group><field name="clickbuild_privacy_consent"/><field name="clickbuild_consent_at"/></group>
                    </group>
                    <group><field name="clickbuild_landing_page"/><field name="clickbuild_referrer"/><field name="clickbuild_utm_term"/><field name="clickbuild_utm_content"/></group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_saas_demo_request_form_crm_bridge" model="ir.ui.view">
        <field name="name">saas.demo.request.form.crm.bridge</field>
        <field name="model">saas.demo.request</field>
        <field name="inherit_id" ref="saas_demo_management.view_saas_demo_request_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='privacy_consent']" position="after"><field name="consent_at" readonly="1"/><field name="crm_lead_id" readonly="1"/></xpath></field>
    </record>
</odoo>
