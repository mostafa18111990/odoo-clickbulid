<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trailer_nonconformity_list" model="ir.ui.view">
        <field name="name">trailer.inspection.nonconformity.list</field><field name="model">trailer.inspection.nonconformity</field>
        <field name="arch" type="xml"><list decoration-danger="severity == 'critical' and state != 'closed'" decoration-muted="state == 'closed'"><field name="name"/><field name="inspection_id"/><field name="partner_id"/><field name="vin"/><field name="severity" widget="badge"/><field name="due_date"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_trailer_nonconformity_form" model="ir.ui.view">
        <field name="name">trailer.inspection.nonconformity.form</field><field name="model">trailer.inspection.nonconformity</field>
        <field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit Action" class="btn-primary" invisible="state != 'open'"/><button name="action_verify" type="object" string="Verify" class="btn-primary" invisible="state != 'submitted'" groups="trailer_inspection_saso.group_trailer_reviewer"/><button name="action_close" type="object" string="Close" invisible="state != 'verified'" groups="trailer_inspection_saso.group_trailer_reviewer"/><field name="state" widget="statusbar"/></header><sheet>
            <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
            <group><group><field name="inspection_id"/><field name="line_id"/><field name="partner_id" readonly="1"/><field name="vin" readonly="1"/></group><group><field name="severity"/><field name="due_date"/><field name="verified_by" readonly="1"/><field name="verified_on" readonly="1"/></group></group>
            <group string="Finding and Corrective Action"><field name="finding"/><field name="root_cause"/><field name="corrective_action"/></group><group string="Closure Evidence"><field name="evidence_filename" invisible="1"/><field name="evidence" filename="evidence_filename"/></group>
        </sheet><chatter/></form></field>
    </record>
    <record id="action_trailer_nonconformity" model="ir.actions.act_window"><field name="name">Nonconformities</field><field name="res_model">trailer.inspection.nonconformity</field><field name="view_mode">list,form</field></record>

    <record id="view_trailer_quality_document_list" model="ir.ui.view"><field name="name">trailer.quality.document.list</field><field name="model">trailer.quality.document</field><field name="arch" type="xml"><list decoration-muted="state == 'obsolete'"><field name="code"/><field name="name"/><field name="document_type"/><field name="revision"/><field name="owner_id"/><field name="effective_date"/><field name="next_review_date"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_trailer_quality_document_form" model="ir.ui.view"><field name="name">trailer.quality.document.form</field><field name="model">trailer.quality.document</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'review'" groups="trailer_inspection_saso.group_trailer_reviewer"/><button name="action_obsolete" type="object" string="Mark Obsolete" invisible="state != 'approved'" groups="trailer_inspection_saso.group_trailer_manager"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="document_type"/><field name="revision"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="owner_id"/><field name="reviewer_id"/><field name="effective_date"/><field name="next_review_date"/></group></group><group string="Controlled File"><field name="filename" invisible="1"/><field name="attachment" filename="filename"/></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_trailer_quality_document" model="ir.actions.act_window"><field name="name">Quality Documents</field><field name="res_model">trailer.quality.document</field><field name="view_mode">list,form</field></record>

    <record id="view_trailer_quality_complaint_list" model="ir.ui.view"><field name="name">trailer.quality.complaint.list</field><field name="model">trailer.quality.complaint</field><field name="arch" type="xml"><list decoration-danger="due_date &lt; context_today() and state not in ('resolved','closed')"><field name="name"/><field name="complaint_type"/><field name="partner_id"/><field name="inspection_id"/><field name="received_date"/><field name="assigned_to"/><field name="due_date"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_trailer_quality_complaint_form" model="ir.ui.view"><field name="name">trailer.quality.complaint.form</field><field name="model">trailer.quality.complaint</field><field name="arch" type="xml"><form><header><button name="action_investigate" type="object" string="Start Investigation" class="btn-primary" invisible="state != 'new'"/><button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'investigating'"/><button name="action_close" type="object" string="Close" invisible="state != 'resolved'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="complaint_type"/><field name="partner_id"/><field name="inspection_id"/><field name="received_date"/></group><group><field name="assigned_to"/><field name="due_date"/><field name="closed_on" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Case"><field name="description"/><field name="investigation"/><field name="resolution"/></group></sheet><chatter/></form></field></record>
    <record id="action_trailer_quality_complaint" model="ir.actions.act_window"><field name="name">Complaints and Appeals</field><field name="res_model">trailer.quality.complaint</field><field name="view_mode">list,form</field></record>

    <record id="view_trailer_inspection_graph" model="ir.ui.view"><field name="name">trailer.inspection.graph</field><field name="model">trailer.inspection</field><field name="arch" type="xml"><graph string="Inspection Results" type="bar"><field name="inspection_date" interval="month"/><field name="overall_result"/></graph></field></record>
    <record id="view_trailer_inspection_pivot" model="ir.ui.view"><field name="name">trailer.inspection.pivot</field><field name="model">trailer.inspection</field><field name="arch" type="xml"><pivot string="Inspection Analysis"><field name="inspector_id" type="row"/><field name="category" type="row"/><field name="inspection_date" interval="month" type="col"/><field name="nonconformity_count" type="measure"/></pivot></field></record>
    <record id="action_trailer_dashboard" model="ir.actions.act_window"><field name="name">Inspection Dashboard</field><field name="res_model">trailer.inspection</field><field name="view_mode">graph,pivot,list</field></record>

    <record id="view_trailer_inspection_import_form" model="ir.ui.view"><field name="name">trailer.inspection.import.form</field><field name="model">trailer.inspection.import</field><field name="arch" type="xml"><form string="Import Inspections"><group><p class="text-muted">CSV/XLSX headers: partner_id, inspection_location, inspector_id, product_description, trailer_type, category, vin, manufacturer_name, model_name, gross_weight_kg</p><field name="filename" invisible="1"/><field name="file" filename="filename"/></group><footer><button name="action_import" type="object" string="Import" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="action_trailer_inspection_import" model="ir.actions.act_window"><field name="name">Import Inspections</field><field name="res_model">trailer.inspection.import</field><field name="view_mode">form</field><field name="target">new</field></record>
</odoo>
