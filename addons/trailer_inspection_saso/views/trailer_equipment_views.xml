<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trailer_equipment_list" model="ir.ui.view">
        <field name="name">trailer.inspection.equipment.list</field>
        <field name="model">trailer.inspection.equipment</field>
        <field name="arch" type="xml">
            <list decoration-danger="calibration_status == 'expired'" decoration-warning="calibration_status == 'due_soon'">
                <field name="code"/><field name="name"/><field name="serial_number"/><field name="equipment_type"/>
                <field name="calibration_due_date"/><field name="calibration_status" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_trailer_equipment_form" model="ir.ui.view">
        <field name="name">trailer.inspection.equipment.form</field>
        <field name="model">trailer.inspection.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Calibration Expired" bg_color="text-bg-danger" invisible="calibration_status != 'expired'"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="serial_number"/><field name="equipment_type"/><field name="company_id" groups="base.group_multi_company"/></group>
                        <group><field name="calibrated_on"/><field name="calibration_due_date"/><field name="calibration_status" widget="badge" readonly="1"/><field name="active"/></group>
                    </group>
                    <group string="Calibration Certificate"><field name="calibration_filename" invisible="1"/><field name="calibration_certificate" filename="calibration_filename"/></group>
                    <field name="notes" placeholder="Equipment control notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_trailer_equipment" model="ir.actions.act_window">
        <field name="name">Measuring Equipment</field><field name="res_model">trailer.inspection.equipment</field><field name="view_mode">list,form</field>
    </record>

    <record id="view_trailer_authorization_list" model="ir.ui.view">
        <field name="name">trailer.inspector.authorization.list</field><field name="model">trailer.inspector.authorization</field>
        <field name="arch" type="xml"><list decoration-danger="state == 'expired'"><field name="authorization_number"/><field name="user_id"/><field name="valid_from"/><field name="valid_to"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="view_trailer_authorization_form" model="ir.ui.view">
        <field name="name">trailer.inspector.authorization.form</field><field name="model">trailer.inspector.authorization</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><label for="authorization_number"/><h1><field name="authorization_number"/></h1></div>
                <group><group><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/><field name="valid_from"/><field name="valid_to"/></group><group string="Authorized Categories"><field name="scope_o1"/><field name="scope_o2"/><field name="scope_o3"/><field name="scope_o4"/><field name="state" widget="badge" readonly="1"/></group></group>
                <group string="Authorization Certificate"><field name="certificate_filename" invisible="1"/><field name="certificate" filename="certificate_filename"/></group>
                <field name="notes"/>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_trailer_authorization" model="ir.actions.act_window">
        <field name="name">Inspector Authorizations</field><field name="res_model">trailer.inspector.authorization</field><field name="view_mode">list,form</field>
    </record>
</odoo>
