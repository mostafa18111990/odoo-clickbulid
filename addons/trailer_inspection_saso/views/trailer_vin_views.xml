<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trailer_vin_profile_list" model="ir.ui.view">
        <field name="name">trailer.vin.profile.list</field><field name="model">trailer.vin.profile</field>
        <field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state == 'archived'"><field name="name"/><field name="manufacturer_id"/><field name="wmi"/><field name="vds"/><field name="plant_code"/><field name="low_volume"/><field name="wmi_certificate_number"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="view_trailer_vin_profile_form" model="ir.ui.view">
        <field name="name">trailer.vin.profile.form</field><field name="model">trailer.vin.profile</field>
        <field name="arch" type="xml"><form>
            <header>
                <button name="action_approve" type="object" string="Approve Profile" class="btn-primary" invisible="state != 'draft'" groups="trailer_inspection_saso.group_trailer_manager"/>
                <button name="action_archive" type="object" string="Archive" invisible="state != 'approved'" groups="trailer_inspection_saso.group_trailer_manager"/>
                <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'archived'" groups="trailer_inspection_saso.group_trailer_manager"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,approved,archived"/>
            </header>
            <sheet>
                <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                <group>
                    <group><field name="manufacturer_id" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="wmi" readonly="state != 'draft'"/><field name="vds" readonly="state != 'draft'"/><field name="plant_code" readonly="state != 'draft'"/></group>
                    <group><field name="low_volume" readonly="state != 'draft'"/><field name="low_volume_identifier" invisible="not low_volume" required="low_volume" readonly="state != 'draft'"/><field name="approved_by" readonly="1"/><field name="approved_on" readonly="1"/><field name="active" invisible="1"/></group>
                </group>
                <group string="WMI Authorization"><field name="wmi_certificate_number" readonly="state != 'draft'"/><field name="wmi_certificate_filename" invisible="1"/><field name="wmi_certificate" filename="wmi_certificate_filename" readonly="state != 'draft'"/><field name="assignment_authority_confirmed" readonly="state != 'draft'"/></group>
                <field name="notes"/>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_trailer_vin_profile" model="ir.actions.act_window"><field name="name">VIN Manufacturer Profiles</field><field name="res_model">trailer.vin.profile</field><field name="view_mode">list,form</field></record>

    <record id="view_trailer_vin_sequence_list" model="ir.ui.view">
        <field name="name">trailer.vin.sequence.list</field><field name="model">trailer.vin.sequence</field>
        <field name="arch" type="xml"><list create="false" delete="false" edit="false"><field name="profile_id"/><field name="model_year"/><field name="next_number"/></list></field>
    </record>
    <record id="action_trailer_vin_sequence" model="ir.actions.act_window"><field name="name">VIN Production Sequences</field><field name="res_model">trailer.vin.sequence</field><field name="view_mode">list</field></record>
</odoo>
