<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trailer_inspection_revoke_form" model="ir.ui.view">
        <field name="name">trailer.inspection.revoke.form</field>
        <field name="model">trailer.inspection.revoke</field>
        <field name="arch" type="xml">
            <form string="Revoke Approval">
                <div class="alert alert-danger" role="alert">
                    The report stays as it was signed, is marked revoked and stops verifying as valid.
                    Issue a corrected report as a new inspection of the same trailer.
                </div>
                <group>
                    <field name="inspection_id" invisible="1"/>
                    <field name="inspection_name" string="Report"/>
                    <field name="vin" string="VIN"/>
                    <field name="reason" placeholder="Why is this approval being revoked?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Revoke Approval" class="btn-danger"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
