<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The app landing screen, branded with the operator's own company. -->
    <record id="action_trailer_home" model="ir.actions.client">
        <field name="name">Inspection Workspace</field>
        <field name="tag">trailer_inspection_home</field>
    </record>

    <!-- The root menu carries the operator's company name (set on install and
         kept in sync when the company is renamed) and the app's own icon. -->
    <menuitem id="menu_trailer_root" name="Trailer Inspection" sequence="45"
              web_icon="trailer_inspection_saso,static/description/icon.png"
              groups="trailer_inspection_saso.group_trailer_inspection_user"/>

    <menuitem id="menu_trailer_workspace" name="Workspace" parent="menu_trailer_root"
              action="action_trailer_home" sequence="5"/>

    <menuitem id="menu_trailer_operations" name="Inspection" parent="menu_trailer_root" sequence="10"/>
    <menuitem id="menu_trailer_inspections" name="Inspections" parent="menu_trailer_operations" action="action_trailer_inspection" sequence="10"/>
    <menuitem id="menu_trailer_nonconformities" name="Nonconformities" parent="menu_trailer_operations" action="action_trailer_nonconformity" sequence="20"/>
    <menuitem id="menu_trailer_dashboard" name="Analysis" parent="menu_trailer_operations" action="action_trailer_dashboard" sequence="30"/>

    <menuitem id="menu_trailer_control" name="Accreditation" parent="menu_trailer_root" sequence="20" groups="trailer_inspection_saso.group_trailer_manager"/>
    <menuitem id="menu_trailer_equipment" name="Measuring Equipment" parent="menu_trailer_control" action="action_trailer_equipment" sequence="10"/>
    <menuitem id="menu_trailer_authorizations" name="Inspector Authorizations" parent="menu_trailer_control" action="action_trailer_authorization" sequence="20"/>
    <menuitem id="menu_trailer_quality_documents" name="Quality Documents" parent="menu_trailer_control" action="action_trailer_quality_document" sequence="30"/>
    <menuitem id="menu_trailer_complaints" name="Complaints and Appeals" parent="menu_trailer_control" action="action_trailer_quality_complaint" sequence="40"/>

    <menuitem id="menu_trailer_configuration" name="Standards" parent="menu_trailer_root" sequence="30" groups="trailer_inspection_saso.group_trailer_manager"/>
    <menuitem id="menu_trailer_standards" name="Standards and Regulations" parent="menu_trailer_configuration" action="action_trailer_standard" sequence="10"/>
    <menuitem id="menu_trailer_requirements" name="Inspection Requirements" parent="menu_trailer_configuration" action="action_trailer_requirement" sequence="20"/>
    <menuitem id="menu_trailer_vin_profiles" name="VIN Manufacturer Profiles" parent="menu_trailer_configuration" action="action_trailer_vin_profile" sequence="25"/>
    <menuitem id="menu_trailer_vin_sequences" name="VIN Production Sequences" parent="menu_trailer_configuration" action="action_trailer_vin_sequence" sequence="26"/>
    <menuitem id="menu_trailer_import" name="Import Inspections" parent="menu_trailer_configuration" action="action_trailer_inspection_import" sequence="30"/>
</odoo>
