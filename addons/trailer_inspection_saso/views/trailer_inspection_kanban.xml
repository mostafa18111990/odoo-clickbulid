<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inspection cards: the technician scans the pipeline by status colour,
         VIN and verdict instead of reading a table. -->
    <record id="view_trailer_inspection_kanban" model="ir.ui.view">
        <field name="name">trailer.inspection.kanban</field>
        <field name="model">trailer.inspection</field>
        <field name="arch" type="xml">
            <kanban class="o_trailer_kanban" default_group_by="state" quick_create="false"
                    sample="1">
                <field name="name"/>
                <field name="vin"/>
                <field name="state"/>
                <field name="overall_result"/>
                <field name="nonconformity_count"/>
                <field name="checklist_progress"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="ti-k--{{
                                record.state.raw_value === 'approved' ? 'approved' :
                                record.state.raw_value === 'rejected' ? 'rejected' :
                                record.state.raw_value === 'technical_review' ? 'review' :
                                'progress' }}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="ti-k-title" t-esc="record.name.value"/>
                                <span t-attf-class="ti-badge ti-badge--{{
                                        record.overall_result.raw_value === 'compliant' ? 'pass' :
                                        record.overall_result.raw_value === 'non_compliant' ? 'fail' :
                                        'none' }}"
                                      t-esc="record.overall_result.value"/>
                            </div>
                            <div class="ti-k-vin" t-esc="record.vin.value or '—'"/>
                            <div class="mt-2 small">
                                <div><i class="fa fa-building-o me-1 text-muted" title="Customer"/><field name="partner_id"/></div>
                                <div><i class="fa fa-truck me-1 text-muted" title="Trailer"/><field name="trailer_type"/>
                                    · <field name="category"/></div>
                                <div><i class="fa fa-calendar me-1 text-muted" title="Inspection date"/><field name="inspection_date"/></div>
                            </div>
                            <div class="mt-2">
                                <field name="checklist_progress" widget="progressbar"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="inspector_id" widget="many2one_avatar_user"/>
                                <span t-if="record.nonconformity_count.raw_value > 0"
                                      class="ti-badge ti-badge--fail">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    <t t-esc="record.nonconformity_count.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban first: the app opens on cards, lists stay one click away. -->
    <record id="action_trailer_inspection" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>
</odoo>
