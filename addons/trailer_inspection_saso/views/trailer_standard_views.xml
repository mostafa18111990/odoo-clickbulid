<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trailer_standard_list" model="ir.ui.view">
        <field name="name">trailer.inspection.standard.list</field>
        <field name="model">trailer.inspection.standard</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'superseded'">
                <field name="code"/>
                <field name="edition"/>
                <field name="title_ar"/>
                <field name="authority"/>
                <field name="document_type"/>
                <field name="status" widget="badge"/>
                <field name="effective_date"/>
            </list>
        </field>
    </record>

    <record id="view_trailer_standard_form" model="ir.ui.view">
        <field name="name">trailer.inspection.standard.form</field>
        <field name="model">trailer.inspection.standard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-warning" invisible="status != 'superseded'"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="edition"/>
                            <field name="authority"/>
                            <field name="document_type"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="superseded_by_id" invisible="status != 'superseded'"/>
                            <field name="publication_date"/>
                            <field name="effective_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Titles">
                            <group><field name="title_ar"/><field name="title_en"/></group>
                        </page>
                        <page string="Source Document">
                            <group>
                                <field name="source_url" widget="url"/>
                                <field name="document_filename" invisible="1"/>
                                <field name="document" filename="document_filename"/>
                            </group>
                        </page>
                        <page string="Notes"><field name="notes" placeholder="Controlled revision notes..."/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trailer_standard" model="ir.actions.act_window">
        <field name="name">Standards and Regulations</field>
        <field name="res_model">trailer.inspection.standard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_trailer_requirement_list" model="ir.ui.view">
        <field name="name">trailer.inspection.requirement.list</field>
        <field name="model">trailer.inspection.requirement</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="section_id"/>
                <field name="clause_ref"/>
                <field name="name_ar"/>
                <field name="standard_id"/>
                <field name="criticality" widget="badge"/>
                <field name="response_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_trailer_requirement_form" model="ir.ui.view">
        <field name="name">trailer.inspection.requirement.form</field>
        <field name="model">trailer.inspection.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="clause_ref"/><field name="section_id"/><field name="standard_id"/></group>
                        <group><field name="sequence"/><field name="criticality"/><field name="response_type"/><field name="active"/></group>
                    </group>
                    <notebook>
                        <page string="Requirement">
                            <group><field name="name_ar"/><field name="name_en"/><field name="criterion_ar"/><field name="criterion_en"/></group>
                        </page>
                        <page string="Applicability and Evidence">
                            <group>
                                <group string="Categories"><field name="applies_o1"/><field name="applies_o2"/><field name="applies_o3"/><field name="applies_o4"/></group>
                                <group string="Control"><field name="evidence_required"/><field name="equipment_required"/></group>
                            </group>
                            <group string="Numeric Limits" invisible="response_type != 'numeric'">
                                <field name="minimum_value"/><field name="maximum_value"/><field name="unit"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trailer_requirement" model="ir.actions.act_window">
        <field name="name">Inspection Requirements</field>
        <field name="res_model">trailer.inspection.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
