<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_trailer_inspection" model="ir.sequence">
        <field name="name">Trailer Inspection Report</field>
        <field name="code">trailer.inspection</field>
        <field name="prefix">TI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_trailer_inspection_nc" model="ir.sequence">
        <field name="name">Trailer Inspection Nonconformity</field><field name="code">trailer.inspection.nc</field><field name="prefix">TNC/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_trailer_quality_complaint" model="ir.sequence">
        <field name="name">Trailer Quality Complaint</field><field name="code">trailer.quality.complaint</field><field name="prefix">TCQ/%(year)s/</field><field name="padding">5</field>
    </record>
</odoo>
