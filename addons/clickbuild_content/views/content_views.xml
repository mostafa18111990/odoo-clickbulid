<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clickbuild_application_list" model="ir.ui.view">
        <field name="name">clickbuild.application.list</field>
        <field name="model">clickbuild.application</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="slug"/><field name="group_id"/><field name="website_id"/><field name="published"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_clickbuild_application_form" model="ir.ui.view">
        <field name="name">clickbuild.application.form</field>
        <field name="model">clickbuild.application</field>
        <field name="arch" type="xml">
            <form><sheet><group><group><field name="name"/><field name="slug"/><field name="group_id"/><field name="website_id"/></group><group><field name="sequence"/><field name="published"/><field name="active"/></group></group><notebook><page string="Content"><field name="summary"/><field name="capabilities"/><field name="outcomes"/></page><page string="Relations"><field name="related_application_ids" widget="many2many_tags"/><field name="industry_ids" widget="many2many_tags"/></page><page string="SEO &amp; Media"><field name="seo_title"/><field name="seo_description"/><field name="image" widget="image"/><field name="image_alt"/></page></notebook></sheet></form>
        </field>
    </record>
    <record id="view_clickbuild_industry_list" model="ir.ui.view">
        <field name="name">clickbuild.industry.list</field><field name="model">clickbuild.industry</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="slug"/><field name="demo_template_id"/><field name="website_id"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_clickbuild_industry_form" model="ir.ui.view">
        <field name="name">clickbuild.industry.form</field><field name="model">clickbuild.industry</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="slug"/><field name="website_id"/><field name="demo_template_id"/></group><group><field name="sequence"/><field name="published"/><field name="active"/></group></group><notebook><page string="Content"><field name="summary"/><field name="challenge_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="kind"/><field name="name"/></list></field></page><page string="Applications"><field name="application_ids" widget="many2many_tags"/></page><page string="SEO &amp; Media"><field name="seo_title"/><field name="seo_description"/><field name="image" widget="image"/><field name="image_alt"/></page></notebook></sheet></form></field>
    </record>
    <record id="view_clickbuild_service_list" model="ir.ui.view">
        <field name="name">clickbuild.service.list</field><field name="model">clickbuild.service</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="slug"/><field name="website_id"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_clickbuild_service_form" model="ir.ui.view">
        <field name="name">clickbuild.service.form</field><field name="model">clickbuild.service</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="slug"/><field name="website_id"/></group><group><field name="sequence"/><field name="published"/><field name="active"/></group></group><field name="summary"/><group><field name="cta_label"/><field name="cta_url"/></group><group><field name="seo_title"/><field name="seo_description"/></group></sheet></form></field>
    </record>
    <record id="action_clickbuild_applications" model="ir.actions.act_window"><field name="name">Applications</field><field name="res_model">clickbuild.application</field><field name="view_mode">list,form</field></record>
    <record id="action_clickbuild_industries" model="ir.actions.act_window"><field name="name">Industries</field><field name="res_model">clickbuild.industry</field><field name="view_mode">list,form</field></record>
    <record id="action_clickbuild_services" model="ir.actions.act_window"><field name="name">Services</field><field name="res_model">clickbuild.service</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_clickbuild_content_root" name="ClickBuild 3 Content" parent="website.menu_website_configuration" sequence="45" groups="base.group_system"/>
    <menuitem id="menu_clickbuild_applications" name="Applications" parent="menu_clickbuild_content_root" action="action_clickbuild_applications" sequence="10"/>
    <menuitem id="menu_clickbuild_industries" name="Industries" parent="menu_clickbuild_content_root" action="action_clickbuild_industries" sequence="20"/>
    <menuitem id="menu_clickbuild_services" name="Services" parent="menu_clickbuild_content_root" action="action_clickbuild_services" sequence="30"/>
</odoo>
