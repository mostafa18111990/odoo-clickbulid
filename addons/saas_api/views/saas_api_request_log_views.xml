<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_log_list" model="ir.ui.view">
        <field name="name">saas.api.request.log.list</field>
        <field name="model">saas.api.request.log</field>
        <field name="arch" type="xml">
            <list string="API Logs" decoration-danger="status_code &gt;= 400">
                <field name="create_date"/>
                <field name="token_id"/>
                <field name="user_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="response_time_ms"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>
    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">API Request Logs</field>
        <field name="res_model">saas.api.request.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
