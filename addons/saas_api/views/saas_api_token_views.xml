<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_token_list" model="ir.ui.view">
        <field name="name">saas.api.token.list</field>
        <field name="model">saas.api.token</field>
        <field name="arch" type="xml">
            <list string="API Tokens" decoration-muted="revoked">
                <field name="name"/>
                <field name="user_id"/>
                <field name="tenant_id"/>
                <field name="token_prefix"/>
                <field name="scopes"/>
                <field name="rate_limit_per_minute"/>
                <field name="last_used_at"/>
                <field name="request_count"/>
                <field name="expires_at"/>
                <field name="revoked"/>
            </list>
        </field>
    </record>
    <record id="view_api_token_form" model="ir.ui.view">
        <field name="name">saas.api.token.form</field>
        <field name="model">saas.api.token</field>
        <field name="arch" type="xml">
            <form string="API Token">
                <header>
                    <button name="action_revoke" type="object" string="Revoke"
                            class="btn-danger" invisible="revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="tenant_id"/>
                            <field name="scopes"/>
                            <field name="rate_limit_per_minute"/>
                            <field name="expires_at"/>
                        </group>
                        <group>
                            <field name="token_prefix" readonly="1"/>
                            <field name="plain_token_once" readonly="1"/>
                            <field name="last_used_at" readonly="1"/>
                            <field name="last_used_ip" readonly="1"/>
                            <field name="request_count" readonly="1"/>
                            <field name="revoked" readonly="1"/>
                            <field name="revoked_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_api_token" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">saas.api.token</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
