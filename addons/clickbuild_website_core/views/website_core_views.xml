<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clickbuild_home_section_list" model="ir.ui.view">
        <field name="name">clickbuild.home.section.list</field>
        <field name="model">clickbuild.home.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key" readonly="1"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="published"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_clickbuild_home_section_form" model="ir.ui.view">
        <field name="name">clickbuild.home.section.form</field>
        <field name="model">clickbuild.home.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="key" readonly="1"/><field name="website_id"/></group>
                        <group><field name="sequence"/><field name="published"/><field name="active"/></group>
                    </group>
                    <field name="internal_note" placeholder="Editorial note (not published)"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clickbuild_home_sections" model="ir.actions.act_window">
        <field name="name">Homepage Sections</field>
        <field name="res_model">clickbuild.home.section</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_clickbuild_website_core_root" name="Website Structure"
              parent="clickbuild_content.menu_clickbuild_content_root" sequence="5"
              groups="base.group_system"/>
    <menuitem id="menu_clickbuild_home_sections" name="Homepage Sections"
              parent="menu_clickbuild_website_core_root"
              action="action_clickbuild_home_sections" sequence="10"/>
</odoo>
