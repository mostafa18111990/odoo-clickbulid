<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_search_accessibility"
              name="Accessible Website Search"
              inherit_id="website.website_search_box">
        <xpath expr="//input[@type='search' and @name='search']" position="attributes">
            <attribute name="t-att-aria-label">'بحث في الموقع' if (request.env.lang or '').startswith('ar') else 'Search the website'</attribute>
        </xpath>
    </template>

    <template id="website_mobile_submenu_accessibility"
              name="Accessible Mobile Submenu"
              inherit_id="website.submenu">
        <xpath expr="//button[hasclass('oi-chevron-left')]" position="attributes">
            <attribute name="t-att-aria-label">'العودة إلى القائمة السابقة' if (request.env.lang or '').startswith('ar') else 'Back to previous menu'</attribute>
        </xpath>
    </template>
</odoo>
