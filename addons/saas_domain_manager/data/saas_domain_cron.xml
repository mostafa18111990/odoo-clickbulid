<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_verify_pending_domains" model="ir.cron">
            <field name="name">SaaS Domain: Verify Pending Domains</field>
            <field name="model_id" ref="model_saas_domain"/>
            <field name="state">code</field>
            <field name="code">model.cron_verify_pending()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_renew_ssl" model="ir.cron">
            <field name="name">SaaS Domain: Renew SSL Certificates</field>
            <field name="model_id" ref="model_saas_domain"/>
            <field name="state">code</field>
            <field name="code">model.cron_renew_ssl()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="config_platform_ip" model="ir.config_parameter">
            <field name="key">saas_domain.platform_ip</field>
            <field name="value">129.121.98.243</field>
        </record>
    </data>
</odoo>
