<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_server_credentials_wizard_form" model="ir.ui.view">
        <field name="name">saas.server.credentials.wizard.form</field>
        <field name="model">saas.server.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Server Credentials">
                <group>
                    <field name="server_id"/>
                    <field name="auth_method" widget="radio"/>
                    <field name="ssh_private_key" password="True"
                           invisible="auth_method != 'key'"
                           required="auth_method == 'key'"
                           placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"/>
                    <field name="ssh_key_passphrase" password="True"
                           invisible="auth_method != 'key'"/>
                    <field name="ssh_password" password="True"
                           invisible="auth_method != 'password'"
                           required="auth_method == 'password'"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Credentials are encrypted before they are stored and are never displayed again.
                </div>
                <footer>
                    <button name="action_save" type="object" string="Encrypt &amp; Save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
