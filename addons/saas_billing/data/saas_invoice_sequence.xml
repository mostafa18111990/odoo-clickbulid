<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_saas_invoice" model="ir.sequence">
            <field name="name">SaaS Invoice</field>
            <field name="code">saas.invoice</field>
            <field name="prefix">INV-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_saas_credit_note" model="ir.sequence">
            <field name="name">SaaS Credit Note</field>
            <field name="code">saas.credit.note</field>
            <field name="prefix">CN-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
