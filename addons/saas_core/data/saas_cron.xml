<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_check_trials" model="ir.cron">
            <field name="name">SaaS Core: Check Trial Expirations</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_trials()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_check_grace" model="ir.cron">
            <field name="name">SaaS Core: Check Grace Period Expirations</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_grace_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_archive_cancelled" model="ir.cron">
            <field name="name">SaaS Core: Archive Cancelled Tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model.cron_archive_cancelled()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_delete_archived" model="ir.cron">
            <field name="name">SaaS Core: Delete Archived Tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model.cron_delete_archived()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_retry_jobs" model="ir.cron">
            <field name="name">SaaS Core: Retry Pending Provisioning Jobs</field>
            <field name="model_id" ref="model_saas_provisioning_job"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_pending_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
