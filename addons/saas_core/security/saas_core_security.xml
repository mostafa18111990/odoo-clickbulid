<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_saas_super_admin" model="res.groups">
            <field name="name">SaaS Super Admin</field>
            <field name="implied_ids" eval="[
                (4, ref('saas_tenant_manager.group_saas_admin')),
                (4, ref('saas_tenant_manager.group_saas_manager')),
            ]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_saas_support" model="res.groups">
            <field name="name">SaaS Support Agent</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_saas_analyst" model="res.groups">
            <field name="name">SaaS Analyst</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_provisioning_job_admin" model="ir.rule">
            <field name="name">Provisioning Jobs: Admin Full Access</field>
            <field name="model_id" ref="model_saas_provisioning_job"/>
            <field name="groups" eval="[(4, ref('saas_tenant_manager.group_saas_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_event_admin" model="ir.rule">
            <field name="name">Events: Admin Full Access</field>
            <field name="model_id" ref="model_saas_event"/>
            <field name="groups" eval="[(4, ref('saas_tenant_manager.group_saas_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_audit_admin" model="ir.rule">
            <field name="name">Audit Log: Admin Read</field>
            <field name="model_id" ref="model_saas_audit_log"/>
            <field name="groups" eval="[(4, ref('saas_tenant_manager.group_saas_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_config_super_admin" model="ir.rule">
            <field name="name">Config: Super Admin Only</field>
            <field name="model_id" ref="model_saas_config"/>
            <field name="groups" eval="[(4, ref('group_saas_super_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
