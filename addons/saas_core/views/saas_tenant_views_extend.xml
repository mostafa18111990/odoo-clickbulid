<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the base tenant search view with filters for the saas_core
         state machine (lead, trial, pending_payment, grace_period, etc.) -->
    <record id="view_saas_tenant_search_inherit" model="ir.ui.view">
        <field name="name">saas.tenant.search.inherit</field>
        <field name="model">saas.tenant</field>
        <field name="inherit_id" ref="saas_tenant_manager.view_saas_tenant_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_active']" position="before">
                <filter name="filter_all_live"
                        string="All Live"
                        domain="[('state', 'not in', ['cancelled', 'archived', 'deleted'])]"/>
                <filter name="filter_lead"
                        string="Leads"
                        domain="[('state', '=', 'lead')]"/>
                <filter name="filter_trial"
                        string="On Trial"
                        domain="[('state', '=', 'trial')]"/>
                <filter name="filter_pending_payment"
                        string="Pending Payment"
                        domain="[('state', '=', 'pending_payment')]"/>
                <filter name="filter_grace"
                        string="Grace Period"
                        domain="[('state', '=', 'grace_period')]"/>
                <filter name="filter_cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
            </xpath>
        </field>
    </record>

    <!-- Drop the auto-applied "Active only" filter on the action so new
         leads / trial tenants are visible by default. -->
    <record id="saas_tenant_manager.action_saas_tenant" model="ir.actions.act_window">
        <field name="context">{'search_default_filter_all_live': 1}</field>
    </record>

    <!-- Show the stored tenant admin password in clear text so the platform
         admin can actually read/copy it. The base form masks it with
         password="True" which renders unreadable dots with no reveal option. -->
    <record id="view_saas_tenant_form_inherit_credentials" model="ir.ui.view">
        <field name="name">saas.tenant.form.inherit.credentials</field>
        <field name="model">saas.tenant</field>
        <field name="inherit_id" ref="saas_tenant_manager.view_saas_tenant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='admin_password']" position="attributes">
                <attribute name="password"></attribute>
                <attribute name="widget">CopyClipboardChar</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_extend_trial" type="object"
                        string="⏰ تمديد 7 أيام / Extend +7 Days"
                        class="btn btn-info"
                        groups="saas_tenant_manager.group_saas_admin"
                        invisible="state not in ('trial', 'suspended')"
                        confirm="سيتم تمديد تاريخ قفل القاعدة 7 أيام. إذا كان العميل موقوفاً سيعود للعمل فوراً ويُلغى العد التنازلي للحذف. متابعة؟ — Extends the lock date by 7 days. A suspended tenant is unblocked immediately and the auto-delete countdown resets. Continue?"/>
                <button name="action_destroy_permanently" type="object"
                        string="🗑 حذف نهائي / Delete Permanently"
                        class="btn btn-danger"
                        groups="saas_tenant_manager.group_saas_admin"
                        invisible="state == 'deleted'"
                        confirm="⚠️ سيتم حذف قاعدة بيانات العميل وملفاته ودومينه نهائياً ولا يمكن تشغيلها مرة أخرى (تُحفظ نسخة احتياطية أخيرة في /opt/backups/deleted). هل أنت متأكد؟ — This PERMANENTLY destroys the tenant database, files, domain and SSL cert. A final backup is kept in /opt/backups/deleted. Continue?"/>
            </xpath>
            <!-- Lock-date control: the trial end date drives when the
                 lifecycle engine physically stops the tenant, so editing it
                 here = full admin control over the lock date. -->
            <xpath expr="//field[@name='admin_login']/.." position="before">
                <group string="🔒 التحكم في القفل والحذف — Lock &amp; Deletion Control">
                    <group>
                        <field name="trial_ends_at" string="تاريخ القفل (نهاية التجربة)"
                               help="عند حلول هذا التاريخ يتم إيقاف العميل تلقائياً وعرض صفحة التجديد. عدّل التاريخ لتمديد أو تقصير الفترة."/>
                        <field name="trial_days_left" readonly="1"/>
                    </group>
                    <group>
                        <field name="suspended_at" readonly="1"/>
                        <field name="auto_delete_at" readonly="1"
                               decoration-danger="auto_delete_at"
                               help="التاريخ الذي سيتم فيه الحذف النهائي التلقائي إذا لم يُسدَّد الاشتراك (تاريخ الإيقاف + مهلة قاعدة دورة الحياة)."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
