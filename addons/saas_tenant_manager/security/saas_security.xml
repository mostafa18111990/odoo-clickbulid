<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Groups — Odoo 19: no category_id (use privilege_id), users -> user_ids -->
        <record id="group_saas_admin" model="res.groups">
            <field name="name">SaaS Administrator</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_saas_manager" model="res.groups">
            <field name="name">SaaS Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Access control is in ir.access.csv. The removed record rules had
             always-true domains and did not restrict records. -->

    </data>
</odoo>
