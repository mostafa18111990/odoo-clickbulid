<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="category_technical" model="saas.ticket.category">
            <field name="name">Technical Issue</field>
            <field name="name_ar">مشكلة تقنية</field>
            <field name="code">technical</field>
            <field name="icon">fa-wrench</field>
            <field name="sequence">10</field>
            <field name="default_priority_id" ref="priority_normal"/>
        </record>
        <record id="category_billing" model="saas.ticket.category">
            <field name="name">Billing Question</field>
            <field name="name_ar">سؤال عن الفواتير</field>
            <field name="code">billing</field>
            <field name="icon">fa-credit-card</field>
            <field name="sequence">20</field>
            <field name="default_priority_id" ref="priority_normal"/>
        </record>
        <record id="category_account" model="saas.ticket.category">
            <field name="name">Account Management</field>
            <field name="name_ar">إدارة الحساب</field>
            <field name="code">account</field>
            <field name="icon">fa-user</field>
            <field name="sequence">30</field>
            <field name="default_priority_id" ref="priority_normal"/>
        </record>
        <record id="category_feature" model="saas.ticket.category">
            <field name="name">Feature Request</field>
            <field name="name_ar">طلب ميزة</field>
            <field name="code">feature_request</field>
            <field name="icon">fa-lightbulb-o</field>
            <field name="sequence">40</field>
            <field name="default_priority_id" ref="priority_low"/>
        </record>
        <record id="category_bug" model="saas.ticket.category">
            <field name="name">Bug Report</field>
            <field name="name_ar">تقرير خلل</field>
            <field name="code">bug</field>
            <field name="icon">fa-bug</field>
            <field name="sequence">50</field>
            <field name="default_priority_id" ref="priority_high"/>
        </record>
        <record id="category_other" model="saas.ticket.category">
            <field name="name">Other</field>
            <field name="name_ar">أخرى</field>
            <field name="code">other</field>
            <field name="icon">fa-question-circle</field>
            <field name="sequence">99</field>
            <field name="default_priority_id" ref="priority_normal"/>
        </record>
    </data>
</odoo>
