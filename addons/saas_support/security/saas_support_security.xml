<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_portal_own_tickets" model="ir.rule">
            <field name="name">Portal: Own Tickets Only</field>
            <field name="model_id" ref="model_saas_ticket"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('tenant_id.portal_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_portal_ticket_messages" model="ir.rule">
            <field name="name">Portal: Own Ticket Messages (non-internal)</field>
            <field name="model_id" ref="model_saas_ticket_message"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('ticket_id.tenant_id.portal_user_id', '=', user.id), ('is_internal', '=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
