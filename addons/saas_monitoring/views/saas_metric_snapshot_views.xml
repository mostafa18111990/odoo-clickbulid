<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_metric_snapshot_list" model="ir.ui.view">
        <field name="name">saas.metric.snapshot.list</field>
        <field name="model">saas.metric.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="sampled_at"/>
                <field name="metric_name"/>
                <field name="value"/>
                <field name="labels"/>
            </list>
        </field>
    </record>
    <record id="view_metric_snapshot_graph" model="ir.ui.view">
        <field name="name">saas.metric.snapshot.graph</field>
        <field name="model">saas.metric.snapshot</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="sampled_at"/>
                <field name="value" type="measure"/>
                <field name="metric_name" type="row"/>
            </graph>
        </field>
    </record>
    <record id="action_metric_snapshot" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">saas.metric.snapshot</field>
        <field name="view_mode">list,graph</field>
    </record>
</odoo>
