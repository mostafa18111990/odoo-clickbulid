<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_run_health_checks" model="ir.cron">
            <field name="name">SaaS Monitoring: Run Health Checks</field>
            <field name="model_id" ref="model_saas_health_check"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_health_checks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_sample_metrics" model="ir.cron">
            <field name="name">SaaS Monitoring: Sample Metrics</field>
            <field name="model_id" ref="model_saas_metric_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_sample_metrics()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_prune_metrics" model="ir.cron">
            <field name="name">SaaS Monitoring: Prune Old Metrics</field>
            <field name="model_id" ref="model_saas_metric_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_prune_old()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
