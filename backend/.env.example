# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clickbuild:PASSWORD@localhost:5432/clickbuild_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clickbuild
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=clickbuild_platform

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=your-redis-password

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@clickbuild.com
EMAIL_FROM_NAME=ClickBuild

# ─── Odoo ────────────────────────────────────────────────────────────────────
ODOO_MASTER_PASSWORD=very-strong-master-password
ODOO_PORT_START=8100
ODOO_PORT_END=9000
ODOO_VERSIONS=["19"]
ODOO_DEFAULT_VERSION=19

# ─── PayMob (Egypt) ──────────────────────────────────────────────────────────
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
PAYMOB_CARD_INTEGRATION_ID=0
PAYMOB_WALLET_INTEGRATION_ID=0
PAYMOB_FAWRY_INTEGRATION_ID=0

# ─── PayTabs (Arabia) ─────────────────────────────────────────────────────────
PAYTABS_PROFILE_ID=your-profile-id
PAYTABS_SERVER_KEY=your-server-key
PAYTABS_REGION=EGY

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://clickbuild.com
ALLOWED_ORIGINS=["https://clickbuild.com","https://www.clickbuild.com"]
