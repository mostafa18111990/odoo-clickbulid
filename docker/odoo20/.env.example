# Copy to .env on the server and replace every placeholder. Never commit .env.
ODOO20_DB_PASSWORD=replace-with-a-long-random-value
ODOO20_MASTER_PASSWORD=replace-with-a-long-random-value
ODOO20_ENTERPRISE_PATH=/opt/odoo-saas/enterprise20
ODOO_NETWORK=odoo-saas_default
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SSL=starttls
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=noreply@example.com
